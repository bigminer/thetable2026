# Optional: used for semantic sermon retrieval embeddings.
# If omitted, Ask falls back to local keyword retrieval over the transcript archive.
OPENAI_API_KEY=sk-...

# Used for answer composition on the Ask page.
#
# --- Groq (recommended for production) ---
# Sign up free at https://console.groq.com, create an API key, then:
# ASK_LLM_BASE_URL=https://api.groq.com/openai/v1
# ASK_LLM_MODEL=llama-3.3-70b-versatile
# ASK_LLM_API_KEY=gsk_...
#
# --- Local llama.cpp (default for development) ---
ASK_LLM_BASE_URL=http://127.0.0.1:8080/v1
ASK_LLM_MODEL=Qwen3-8B-Q4_K_M.gguf
# ASK_LLM_API_KEY=

# Contact and newsletter forms (Resend).
# Sign up free at https://resend.com, verify thetabletx.com as a sending domain,
# then create an API key.
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@thetabletx.com
# CONTACT_FROM_EMAIL=noreply@thetabletx.com

# Optional public analytics IDs. Prefer PUBLIC_GTM_ID for production so Google
# Analytics can be managed in Tag Manager. If PUBLIC_GTM_ID is unset,
# PUBLIC_GA4_ID enables direct GA4 gtag.js tracking.
# PUBLIC_GTM_ID=GTM-XXXXXXX
# PUBLIC_GA4_ID=G-XXXXXXXXXX
