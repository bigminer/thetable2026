---
import { getCollection, getEntry, render } from 'astro:content';
import { fallbackSlug, resolveAsset, safeGetCollection } from '../lib/content';
import Layout from '../layouts/Layout.astro';

const siteConfig = await getEntry('site', 'homepage');

export async function getStaticPaths() {
	const entries = await safeGetCollection(() => getCollection('pages', ({ data }) => !data.draft));
	return entries.map((entry) => ({
		params: { slug: fallbackSlug(entry.data.slug, entry.id) },
		props: { entry },
	}));
}

// getStaticPaths is ignored in server mode — look up entry by slug at request time.
let entry = Astro.props.entry;
if (!entry) {
	const slug = Astro.params.slug ?? '';
	const entries = await safeGetCollection(() => getCollection('pages', ({ data }) => !data.draft));
	entry = entries.find((e) => fallbackSlug(e.data.slug, e.id) === slug);
}
if (!entry) return Astro.redirect('/404', 302);

const { Content } = await render(entry);
const pageSlug = fallbackSlug(entry.data.slug, entry.id);

const sectionLabel = (() => {
	const routeGroups: Array<{ match: RegExp; label: string }> = [
		{ match: /^new-here(?:\/|$)/, label: 'New Here' },
		{ match: /^service-times-locations(?:\/|$)/, label: 'Service' },
		{ match: /^(our-story|our-vision|leadership)(?:\/|$)/, label: 'Who We Are' },
		{ match: /^(meetups|kids-youth|community-meal|get-involved)(?:\/|$)/, label: 'Join In' },
		{ match: /^(contact-us|sign-up-for-our-newsletter)(?:\/|$)/, label: 'Connect With Us' },
	];

	for (const group of routeGroups) {
		if (group.match.test(pageSlug)) return group.label;
	}

	return entry.data.navTitle?.trim() || entry.data.title;
})();
---

<Layout title={`${entry.data.title} | The Table Church`} description={entry.data.description}>
	<article class="content-page">
		<header class="page-hero">
			<div class="hero-copy">
				<p class="eyebrow">{sectionLabel}</p>
				<h1>{entry.data.title}</h1>
				{entry.data.lede && <p class="lede">{entry.data.lede}</p>}
				{!entry.data.lede && entry.data.description && <p class="lede">{entry.data.description}</p>}
			</div>
			{entry.data.heroImage && (
				<img src={resolveAsset(entry.data.heroImage)} alt={entry.data.heroImageAlt ?? entry.data.title} />
			)}
		</header>
		<div class="content-grid">
			<section class="body">
				<Content />

				{entry.data.staffCards && entry.data.staffCards.length > 0 && (
					<section class="staff-section">
						<h2>Leadership Team</h2>
						<div class="staff-grid">
							{entry.data.staffCards.map((card) => (
								<article class="staff-card">
									{card.image && (
										<img src={resolveAsset(card.image)} alt={card.imageAlt ?? card.name} />
									)}
									<div class="staff-copy">
										<h3>{card.name}</h3>
										<p class="staff-role">{card.role}</p>
										{card.pronouns && <p class="staff-pronouns">{card.pronouns}</p>}
									</div>
								</article>
							))}
						</div>
					</section>
				)}
			</section>

			{entry.data.showSidebar && siteConfig && (
				<aside class="sidebar">
					<section class="sidebar-card">
						<h2>Our Vision</h2>
						<p>We exist to shift a generation from reactionary to visionary through the person and work of Jesus.</p>
					</section>
					<section class="sidebar-card">
						<h2>Connect With Us</h2>
						{siteConfig.data.addressLines && (
							<address class="sidebar-address">
								{siteConfig.data.addressLines.map((line) => <span>{line}</span>)}
							</address>
						)}
						{siteConfig.data.serviceTime && (
							<p class="service-time">{siteConfig.data.serviceTime}</p>
						)}
						{siteConfig.data.mapEmbedUrl && (
							<iframe
								src={siteConfig.data.mapEmbedUrl}
								title="Map to The Table"
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
							/>
						)}
					</section>
					{(() => {
						const fbLink = siteConfig.data.socialLinks?.find(l => l.label === 'Facebook');
						return fbLink?.url ? (
						<section class="sidebar-card">
							<h2>Connect With Us On Facebook</h2>
							<a class="sidebar-social-link" href={fbLink.url} target="_blank" rel="noreferrer">
								Follow us on Facebook
							</a>
						</section>
						) : null;
					})()}
				</aside>
			)}
		</div>
	</article>
</Layout>

<style>
	.content-page {
		display: grid;
		gap: 2rem;
	}

	.page-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
		gap: 1.5rem;
		align-items: center;
	}

	.hero-copy {
		max-width: 44rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--brand-rust);
		font: 700 0.82rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.2rem, 5vw, 4rem);
		line-height: 0.95;
	}

	.lede {
		margin: 0;
		color: var(--text-secondary);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.page-hero img {
		width: 100%;
		border-radius: var(--radius-card);
		object-fit: cover;
		box-shadow: var(--shadow-card);
	}

	.content-grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(280px, 0.95fr);
		gap: 1.5rem;
		align-items: start;
	}

	.body {
		line-height: 1.8;
	}

	.body :global(p),
	.body :global(li) {
		color: var(--text-body);
	}

	.body :global(img) {
		display: block;
		max-width: min(100%, 480px);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-sm);
		margin: 1.5rem 0;
	}

	.body :global(.content-map-embed) {
		display: block;
		width: 100%;
		min-height: 320px;
		border: 0;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-sm);
		margin: 1.5rem 0;
	}

	.body :global(em) {
		color: var(--text-secondary);
	}

	.staff-section {
		margin-top: 2.5rem;
	}

	.staff-section h2 {
		margin-bottom: 1rem;
	}

	.staff-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
	}

	.staff-card {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 22px;
		background: var(--bg-surface);
		box-shadow: var(--shadow-sm);
	}

	.staff-card img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		margin: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.staff-copy {
		padding: 1rem;
	}

	.staff-copy h3 {
		margin: 0 0 0.4rem;
	}

	.staff-role,
	.staff-pronouns {
		margin: 0;
		color: var(--text-body);
	}

	.staff-pronouns {
		margin-top: 0.25rem;
		color: var(--text-secondary);
		font-style: italic;
	}

	.sidebar {
		display: grid;
		gap: 1rem;
	}

	.sidebar-card {
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: 24px;
		padding: 1.15rem;
		box-shadow: var(--shadow-sm);
	}

	.sidebar-card h2 {
		margin-bottom: 0.65rem;
		font-size: 1.3rem;
	}

	.sidebar-card p,
	.sidebar-card li {
		color: var(--text-body);
		line-height: 1.7;
	}

	.sidebar-card ul {
		margin: 0 0 0.75rem;
		padding-left: 1.1rem;
	}

	.sidebar-address {
		display: grid;
		gap: 0.2rem;
		font-style: normal;
		line-height: 1.55;
		color: var(--text-body);
		margin: 0 0 0.75rem;
	}

	.service-time {
		margin: 0.5rem 0 0.9rem;
		font-family: 'Trebuchet MS', sans-serif;
		font-weight: 700;
		color: var(--brand-rust);
	}

	.sidebar-card iframe {
		display: block;
		width: 100%;
		min-height: 220px;
		border: 0;
		border-radius: 18px;
	}

	.sidebar-social-link {
		display: inline-block;
		margin-top: 0.25rem;
		color: var(--brand-rust);
		font: 700 0.95rem/1 'Trebuchet MS', sans-serif;
		text-decoration: none;
	}

	@media (max-width: 820px) {
		.page-hero,
		.content-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
