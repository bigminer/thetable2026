---
import { getCollection, getEntry } from 'astro:content';
import { fallbackSlug, resolveAsset, safeGetCollection } from '../../lib/content';
import { getMessagesForSeries, sortSeriesEntries } from '../../lib/podcast';
import Layout from '../../layouts/Layout.astro';

const messages = await safeGetCollection(() => getCollection('messages', ({ data }) => !data.draft));
const entries = sortSeriesEntries(
	await safeGetCollection(() => getCollection('series', ({ data }) => !data.draft)),
	messages,
);
const siteConfig = await getEntry('site', 'homepage');
const podcastLinks = siteConfig?.data.podcastLinks?.filter((l) => l.url?.trim()) ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Series | The Table Church" description="Browse message series from The Table Church.">
	<section class="hero">
		<p class="eyebrow">Service</p>
		<h1>Message Series</h1>
		<p class="lede">Choose one of our series to listen to a message, share with a friend, or revisit later.</p>
		{podcastLinks.length > 0 && (
			<div class="podcast-links">
				<p class="podcast-label">Subscribe</p>
				{podcastLinks.map((link) => (
					<a class="podcast-btn" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
				))}
			</div>
		)}
	</section>

	<section class="series-grid" aria-label="Series list">
		{entries.map((entry) => {
			const seriesSlug = fallbackSlug(entry.data.slug, entry.id);
			const messageCount = getMessagesForSeries(messages, seriesSlug).length;

			return (
				<article class="series-card">
					{entry.data.featuredImage && (
						<img src={resolveAsset(entry.data.featuredImage)} alt={entry.data.featuredImageAlt ?? entry.data.title} />
					)}
					<div class="series-copy">
						<p class="eyebrow">Series</p>
						<h2><a href={`${base}/series/${seriesSlug}/`}>{entry.data.title}</a></h2>
						<p>{entry.data.description}</p>
						{messageCount > 0 && (
							<p class="episode-count">
								{messageCount} message{messageCount === 1 ? '' : 's'}
							</p>
						)}
					</div>
				</article>
			);
		})}
	</section>
	{entries.length === 0 && (
		<section class="empty-state">
			<p>No series entries have been migrated yet.</p>
		</section>
	)}
</Layout>

<style>
	.hero {
		max-width: 48rem;
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--brand-rust);
		font: 700 0.82rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.4rem, 6vw, 4.4rem);
		line-height: 0.95;
	}

	.lede {
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--text-secondary);
	}

	.podcast-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.podcast-label {
		margin: 0;
		font: 700 0.8rem/1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--brand-rust);
	}

	.podcast-btn {
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		background: var(--brand-cream);
		color: var(--text-primary);
		font: 700 0.88rem/1 'Trebuchet MS', sans-serif;
		text-decoration: none;
	}

	.series-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}

	.empty-state {
		margin-top: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-surface);
		color: var(--text-secondary);
	}

	.series-card {
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: 24px;
		overflow: hidden;
		box-shadow: var(--shadow-card);
	}

	.series-card img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.series-copy {
		padding: 1rem 1rem 1.2rem;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.5rem;
	}

	h2 a {
		text-decoration: none;
	}

	.series-copy p:last-child {
		margin-bottom: 0;
		line-height: 1.65;
		color: var(--text-secondary);
	}

	.episode-count {
		margin-top: 0.9rem;
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 0.84rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-teal);
	}
</style>
