---
import { fallbackSlug, resolveAsset } from '../../lib/content';
import {
	collectPodcastEpisodes,
	formatMessageDate,
	getMessageEntries,
	getMessageSlug,
	getSeriesEntries,
	loadPodcastPage,
	sortSeriesEntries,
} from '../../lib/podcast';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const seriesEntries = await getSeriesEntries();
	const messageEntries = await getMessageEntries();
	return collectPodcastEpisodes(seriesEntries, messageEntries).map((episode) => ({
		params: { slug: episode.slug },
		props: { episode },
	}));
}

// getStaticPaths is ignored in server mode — look up episode by slug at request time.
let episode = Astro.props.episode;
if (!episode) {
	const slug = Astro.params.slug ?? '';
	const seriesEntries = await getSeriesEntries();
	const messageEntries = await getMessageEntries();
	episode = collectPodcastEpisodes(seriesEntries, messageEntries).find((e) => e.slug === slug);
	if (!episode) return Astro.redirect('/404', 302);
}
const remoteData = await loadPodcastPage(episode);
const seriesEntries = await getSeriesEntries();
const messageEntries = await getMessageEntries();
const relatedSeries = sortSeriesEntries(seriesEntries, messageEntries)
	.filter((entry) => fallbackSlug(entry.data.slug, entry.id) !== episode.seriesSlug)
	.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const youtubeUrl = remoteData.sourceUrl ?? episode.sourceUrl;
const podcastUrl = remoteData.podcastUrl ?? episode.podcastUrl;
const podcastLabel = podcastUrl?.includes('spotify.com') ? 'Listen on Spotify' : 'Listen to Podcast';
---

<Layout title={`${remoteData.title} | The Table Church`} description={remoteData.seriesDescription}>
	<article class="podcast-entry">
		<section class="podcast-hero">
			<div class="podcast-media">
				{remoteData.embedUrl ? (
					<iframe
						src={remoteData.embedUrl}
						title={remoteData.title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					/>
				) : (
					<div class="media-fallback">
						<p class="eyebrow">Message</p>
						<h2>Media is being finalized for this episode.</h2>
						<p>The message details are available now while the local playback experience is completed.</p>
					</div>
				)}
				{(youtubeUrl || podcastUrl) && (
					<div class="media-actions">
						{youtubeUrl && (
							<a class="media-link primary" href={youtubeUrl} target="_blank" rel="noreferrer">Watch on YouTube</a>
						)}
						{podcastUrl && (
							<a class="media-link secondary" href={podcastUrl} target="_blank" rel="noreferrer">{podcastLabel}</a>
						)}
					</div>
				)}
			</div>

			<div class="podcast-copy">
				<p class="eyebrow">Podcast</p>
				<h1>{remoteData.title}</h1>
				<div class="meta-row">
					{remoteData.dateLabel && <p>{remoteData.dateLabel}</p>}
					{remoteData.speaker && <p>{remoteData.speaker}</p>}
				</div>
				<div class="series-card">
					<p class="eyebrow">Series</p>
					<h2>
						<a href={`${base}/series/${episode.seriesSlug}/`}>{remoteData.seriesTitle}</a>
					</h2>
					<p>{remoteData.seriesDescription}</p>
				</div>
			</div>
		</section>

		<section class="podcast-grid">
			<div class="messages-card">
				<h2>Messages In Series</h2>
				<div class="message-list">
					{episode.seriesMessages.map((seriesMessage) => {
						const podcastPath = `/podcast/${getMessageSlug(seriesMessage)}/`;
						const active = podcastPath === `/podcast/${episode.slug}/`;
						return (
							<article class:list={['message-row', active && 'is-active']}>
								<div>
									<h3>
										<a href={base + podcastPath}>{seriesMessage.data.title}</a>
									</h3>
									<p>{formatMessageDate(seriesMessage.data.date)}</p>
								</div>
							</article>
						);
					})}
				</div>
			</div>

			{relatedSeries.length > 0 && (
				<aside class="related-card">
					<h2>More Series</h2>
					<div class="related-list">
						{relatedSeries.map((entry) => (
							<article class="related-item">
								{entry.data.featuredImage && (
									<img src={resolveAsset(entry.data.featuredImage)} alt={entry.data.featuredImageAlt ?? entry.data.title} />
								)}
								<div>
									<h3>
										<a href={`${base}/series/${fallbackSlug(entry.data.slug, entry.id)}/`}>{entry.data.title}</a>
									</h3>
									<p>{entry.data.description}</p>
								</div>
							</article>
						))}
					</div>
				</aside>
			)}
		</section>
	</article>
</Layout>

<style>
	.podcast-entry {
		display: grid;
		gap: 2rem;
	}

	.podcast-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.95fr);
		gap: 1.5rem;
		align-items: start;
	}

	.podcast-media iframe,
	.media-fallback,
	.podcast-copy,
	.messages-card,
	.related-card {
		width: 100%;
		border: 1px solid rgba(33, 48, 52, 0.12);
		border-radius: 28px;
		background: rgba(255, 252, 247, 0.82);
		box-shadow: 0 18px 40px rgba(33, 48, 52, 0.08);
	}

	.podcast-media iframe {
		display: block;
		aspect-ratio: 16 / 9;
		min-height: 22rem;
		border: 0;
	}

	.media-fallback {
		display: grid;
		align-content: center;
		aspect-ratio: 16 / 9;
		min-height: 22rem;
	}

	.media-fallback h2,
	.media-fallback p {
		max-width: 34rem;
	}

	.media-fallback,
	.podcast-copy,
	.messages-card,
	.related-card {
		padding: 1.5rem;
		box-sizing: border-box;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		color: #9e3f31;
		font: 700 0.82rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 0.75rem;
		font-size: clamp(2.2rem, 5vw, 4rem);
		line-height: 0.95;
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1.2rem;
		margin-bottom: 1.25rem;
		color: #4e5d5c;
		font-family: 'Trebuchet MS', sans-serif;
	}

	.meta-row p,
	.series-card p,
	.message-row p,
	.related-item p,
	.media-fallback p {
		margin: 0;
		line-height: 1.7;
		color: #4e5d5c;
	}

	.series-card {
		padding-top: 0.25rem;
	}

	.podcast-media {
		display: grid;
		gap: 0.85rem;
	}

	.media-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.media-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1rem;
		border-radius: 999px;
		font: 700 0.88rem/1 'Trebuchet MS', sans-serif;
		text-decoration: none;
	}

	.media-link.primary {
		background: #d65a42;
		color: #fff8f2;
	}

	.media-link.secondary {
		border: 1px solid rgba(47, 119, 124, 0.35);
		background: #fff8f2;
		color: #2f777c;
	}

	.series-card a,
	.message-row a,
	.related-item a {
		text-decoration: none;
	}

	.podcast-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.9fr);
		gap: 1.5rem;
		align-items: start;
	}

	.message-list,
	.related-list {
		display: grid;
		gap: 0.85rem;
	}

	.message-row,
	.related-item {
		display: grid;
		gap: 0.5rem;
		padding: 1rem;
		border: 1px solid rgba(33, 48, 52, 0.12);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.58);
	}

	.message-row.is-active {
		border-color: rgba(214, 90, 66, 0.35);
		background: rgba(214, 90, 66, 0.08);
	}

	.related-item img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: 16px;
	}

	@media (max-width: 900px) {
		.podcast-hero,
		.podcast-grid {
			grid-template-columns: 1fr;
		}

		.podcast-media iframe,
		.media-fallback {
			min-height: 16rem;
		}
	}
</style>
