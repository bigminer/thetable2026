---
// Proposed homepage — v0.
// Restraint over polish. Specificity over reassurance. Evidence over claim.
// The existing Layout (nav, footer) is preserved per Brett's approval of nav.

import Layout from '../layouts/Layout.astro';
import { resolveAsset } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroVideo = resolveAsset('attachments/video/homepage/Table-B-roll-mp4.mp4');
---

<Layout
	title="The Table Church"
	description="A church in Sachse, Texas, founded for full LGBTQ affirmation."
>
	<section class="hero">
		{heroVideo && (
			<video
				class="hero-bg"
				src={heroVideo}
				autoplay
				muted
				loop
				playsinline
				aria-hidden="true"
			/>
		)}
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<h1>The Table exists because<br /><em>"almost affirming"</em><br />wasn't enough.</h1>
			<p class="subline">We believe following Jesus<br />should never require hiding who you are.</p>
		</div>
		<div class="hero-actions">
			<a class="cta" href={base + '/our-story/'}>Our Story</a>
			<a class="cta" href={base + '/what-sundays-are-like/'}>What Sundays Are Like</a>
			<a class="cta" href={base + '/plan-your-visit/'}>Plan Your Visit</a>
		</div>
	</section>

	<section class="values">
		<h2>We try to be</h2>
		<ul class="values-list">
			<li>
				<h3>Thoughtful</h3>
				<p>We try to do things deliberately, and to say what we mean — even when it's harder.</p>
			</li>
			<li>
				<h3>Inclusive</h3>
				<p>Everyone belongs here. Including the parts of yourself you've been told to hide.</p>
			</li>
			<li>
				<h3>Eclectic</h3>
				<p>We're built from different stories, traditions, and questions. There isn't one way to be at this table.</p>
			</li>
			<li>
				<h3>Communal</h3>
				<p>We try to be present for each other — Sundays, weekdays, easy seasons and hard ones.</p>
			</li>
			<li>
				<h3>Vulnerable</h3>
				<p>We tell our actual stories. We try to be honest about what we don't yet understand.</p>
			</li>
		</ul>
	</section>
</Layout>

<style>
	/* Break the hero out of site-main's padding so it spans full-width. */
	.hero {
		position: relative;
		min-height: 72vh;
		margin-top: calc(-1 * clamp(1.25rem, 4vw, 3rem));
		margin-left: calc(-1 * clamp(1.25rem, 4vw, 3rem));
		margin-right: calc(-1 * clamp(1.25rem, 4vw, 3rem));
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #1a1815;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(20, 18, 15, 0.6) 0%,
			rgba(20, 18, 15, 0.25) 30%,
			rgba(20, 18, 15, 0.25) 70%,
			rgba(20, 18, 15, 0.6) 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		padding: 3.5rem clamp(1.25rem, 3vw, 2.5rem) 0;
		color: #fdfaf4;
		font-family: 'Lora', serif;
		box-sizing: border-box;
	}

	.hero-content h1 {
		margin: 0 0 1.5rem;
		max-width: 52rem;
		font-weight: 600;
		font-size: clamp(1.85rem, 4.4vw, 3.4rem);
		line-height: 1.18;
		letter-spacing: -0.005em;
		color: inherit;
		text-wrap: balance;
	}

	.hero-content h1 em {
		font-style: italic;
	}

	.hero-content .subline {
		margin: 0;
		max-width: 38rem;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.55;
		color: rgba(253, 250, 244, 0.92);
	}

	.hero-actions {
		position: relative;
		z-index: 2;
		margin-top: auto;
		padding: 2rem clamp(1.25rem, 3vw, 2.5rem) 3rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 1.25rem 1.75rem;
		box-sizing: border-box;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		background: #fdfaf4;
		color: #1a1815;
		font: 600 1rem/1 'Lora', serif;
		text-decoration: none;
		transition: background 0.15s, transform 0.15s;
	}

	.cta:hover {
		background: #fff;
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-bg {
			display: none;
		}

		.cta {
			transition: none;
		}

		.cta:hover {
			transform: none;
		}
	}

	.values {
		max-width: 84rem;
		margin: 8rem auto;
		padding: 0 clamp(1.25rem, 3vw, 2.5rem);
		font-family: 'Lora', serif;
	}

	.values h2 {
		margin: 0 0 2.5rem;
		font-weight: 500;
		font-size: clamp(1.2rem, 1.8vw, 1.5rem);
		color: var(--text-secondary, #555);
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}

	.values-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 2rem;
	}

	.values-list li {
		padding: 2rem 0 0;
		border-top: 2px solid var(--brand-rust, #8b3a2b);
	}

	.values-list h3 {
		margin: 0 0 1rem;
		font-weight: 600;
		font-size: clamp(1.4rem, 2.2vw, 1.85rem);
		line-height: 1.1;
		letter-spacing: -0.005em;
		color: var(--text-primary, #1a1a1a);
	}

	.values-list p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-body, #333);
	}

	@media (max-width: 900px) {
		.values-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 3rem 2rem;
		}
	}

	@media (max-width: 600px) {
		.hero {
			min-height: 80vh;
		}

		.hero-content {
			padding: 3rem 1.25rem 3rem;
		}

		.hero-actions {
			gap: 1rem;
		}

		.values {
			margin: 3rem auto;
		}

		.values-list {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
