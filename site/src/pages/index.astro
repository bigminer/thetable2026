---
// Proposed homepage — v0.
// Restraint over polish. Specificity over reassurance. Evidence over claim.
// The existing Layout (nav, footer) is preserved per Brett's approval of nav.

import Layout from '../layouts/Layout.astro';
import { resolveAsset } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroPhoto = resolveAsset('attachments/homepage/summerrama2023-414.jpg');
---

<Layout
	title="The Table Church"
	description="A church in Sachse, Texas, founded for full LGBTQ affirmation."
>
	<main class="proposed-home">
		<section class="hero">
			<h1>This church exists because <em>"almost affirming"</em> wasn't enough.</h1>
			<p class="subline">We believe following Jesus should never require hiding who you are.</p>
		</section>

		{heroPhoto && (
			<figure class="photo">
				<img
					src={heroPhoto}
					alt="Tie-dye t-shirts hanging on a clothesline at a Table community gathering."
				/>
			</figure>
		)}

		<section class="logistics">
			<p>Sundays at 5pm in Sachse, TX.</p>
			<a href={base + '/our-story/'}>Read why The Table started &rarr;</a>
		</section>
	</main>
</Layout>

<style>
	.proposed-home {
		max-width: 880px;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
		font-family: 'Lora', serif;
		color: var(--text-primary, #1a1a1a);
	}

	.hero {
		padding: 3rem 0 4.5rem;
	}

	.hero h1 {
		font-weight: 600;
		font-size: clamp(1.85rem, 4.4vw, 3.4rem);
		line-height: 1.18;
		letter-spacing: -0.005em;
		margin: 0 0 1.5rem;
	}

	.hero h1 em {
		font-style: italic;
	}

	.subline {
		margin: 0;
		max-width: 38rem;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.5;
		color: var(--text-body, #333);
	}

	.photo {
		margin: 0 0 3rem;
	}

	.photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	.logistics {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 1rem;
	}

	.logistics p {
		margin: 0;
		font-size: 1.05rem;
		color: var(--text-body, #333);
	}

	.logistics a {
		width: fit-content;
		font-size: 1.05rem;
		color: var(--brand-rust, #8b3a2b);
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 1px;
	}

	.logistics a:hover {
		opacity: 0.7;
	}

	@media (max-width: 600px) {
		.proposed-home {
			padding: 2rem 1.25rem 4rem;
		}

		.hero {
			padding: 1.5rem 0 2.5rem;
		}
	}
</style>
