defaultView: Pages
filters:
  and:
    - file.ext == "md"
formulas:
  Slug: |-
    if(file.folder == "pages",
      "/" + file.name.replace(".md", ""),
      if(file.folder == "messages",
        "(series page) " + file.name.replace(".md", ""),
        if(file.folder == "series",
          "/series/" + file.name.replace(".md", ""),
          if(file.folder == "site",
            if(file.name.replace(".md", "") == "homepage",
              "/",
              "/site/" + file.name.replace(".md", "")
            ),
            "/" + file.folder
          )
        )
      )
    )
  Content Folder: |-
    if(file.name == "index",
      if(file.folder != "",
        if(file.folder.replace("/" + file.folder.replace(/.*\//, ""), "") != "",
          file.folder.replace("/" + file.folder.replace(/.*\//, ""), ""),
          file.folder
        ),
        "root"
      ),
      if(file.folder != "",
        file.folder,
        "root"
      )
    )
properties:
  file.fullname:
    displayName: Full File Name
  file.name:
    displayName: File Name
  formula.Content Folder:
    displayName: Collection
  formula.Slug:
    displayName: Path
  note.date:
    displayName: Date
  note.description:
    displayName: Description
  note.draft:
    displayName: Draft
  note.contactActionLabel:
    displayName: Contact Action Label
  note.contactActionUrl:
    displayName: Contact Action URL
  note.featuredImage:
    displayName: FeaturedImage
  note.heroImage:
    displayName: HeroImage
  note.mapEmbedUrl:
    displayName: Map Embed URL
  note.pubDate:
    displayName: Date
  note.series:
    displayName: Series
  note.sourceUrl:
    displayName: Source URL
  note.podcastUrl:
    displayName: Podcast URL
  note.speaker:
    displayName: Speaker
  note.title:
    displayName: Title
views:
  - type: cms
    name: Pages
    filters:
      and:
        - file.folder == "pages"
    order: []
    sort:
      - property: title
        direction: ASC
    fallbackToEmbeds: never
    propertyDisplay1: formula.Slug
    showTextPreview: true
    imageFormat: cover
    imageProperty: note.heroImage
    showDate: false
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 280
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: false
  - type: cms
    name: Messages
    filters:
      and:
        - file.folder == "messages"
    order: []
    sort:
      - property: date
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: formula.Slug
    propertyDisplay2: note.series
    propertyDisplay3: note.speaker
    propertyDisplay4: note.podcastUrl
    showTextPreview: true
    imageFormat: none
    showDate: true
    dateProperty: note.date
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 280
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.sourceUrl
    hideQuickEditIcon: false
  - type: cms
    name: Series
    filters:
      and:
        - file.folder == "series"
    order: []
    sort:
      - property: title
        direction: ASC
    fallbackToEmbeds: never
    propertyDisplay1: formula.Slug
    showTextPreview: true
    imageFormat: cover
    imageProperty: note.featuredImage
    showDate: true
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 280
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: false
  - type: cms
    name: Site
    filters:
      and:
        - file.folder.startsWith("site")
    sort:
      - property: file.ctime
        direction: DESC
    imageFormat: cover
    showDate: true
    customizeNewButton: true
    newNoteLocation: site
    fallbackToEmbeds: if-empty
    propertyDisplay1: file.fullname
    showTextPreview: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: file.ctime
    descriptionProperty: note.intro
    imageProperty: note.heroImage
    showTags: false
    showDraftStatus: true
    draftStatusProperty: note.draft
    draftStatusReverse: false
  - type: cms
    name: Project Guide
    filters:
      and:
        - file.folder == ""
        - file.name == "_GUIDE"
    order: []
    sort:
      - property: file.ctime
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: file.fullname
    showTextPreview: true
    imageFormat: none
    showDate: false
    showDraftStatus: false
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: true
  - type: cms
    name: Site Content
    filters:
      and:
        - file.folder == "site"
    order: []
    sort:
      - property: title
        direction: ASC
    fallbackToEmbeds: never
    propertyDisplay1: formula.Slug
    showTextPreview: true
    imageFormat: cover
    showDate: false
    showDraftStatus: true
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 280
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: false
