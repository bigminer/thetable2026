---
import { getEntry } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	noindex?: boolean;
}

type ChildItem = {
	label: string;
	href: string;
};

type NavItem = {
	label: string;
	href?: string;
	children?: ChildItem[];
	external?: boolean;
};

const { title, description, canonicalPath, image, noindex = false } = Astro.props;
const homepage = await getEntry('site', 'homepage');
const siteName = homepage?.data.title?.trim() || 'The Table Church';
const siteTagline = 'A church community in Sachse, Texas.';
const fallbackDescription = homepage?.data.intro?.trim() || 'A welcoming, inclusive Christian community in Sachse, Texas.';
const metaDescription = description ?? fallbackDescription;
const footerAddressLines = homepage?.data.addressLines?.length
	? homepage.data.addressLines
	: ['1520 Blackburn Rd', 'Sachse, TX 75048'];
const footerServiceTime = homepage?.data.serviceTime?.trim() || 'Sundays at 5:00 pm';
const footerSocialLinks = homepage?.data.socialLinks?.filter((link) => link.url?.trim()) ?? [];
const footerCopyrightYear = new Date().getFullYear();
const googleTagManagerId = import.meta.env.PUBLIC_GTM_ID?.trim();
const googleAnalyticsId = import.meta.env.PUBLIC_GA4_ID?.trim();
const directGoogleAnalyticsId = googleTagManagerId ? undefined : googleAnalyticsId;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL('https://thetabletx.com');
const brandLogoSrc = `${base}/attachments/branding/the-table-written-logo.png`;
const privacyHref = base + '/privacy-policy/';
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentPath = base && rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;
const normalizePath = (path: string) => {
	const withLeadingSlash = path.startsWith('/') ? path : `/${path}`;
	return withLeadingSlash.endsWith('/') ? withLeadingSlash : `${withLeadingSlash}/`;
};
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`.replace(/\/\/+/g, '/');
const absoluteUrl = (pathOrUrl: string) => {
	try {
		return new URL(pathOrUrl).toString();
	} catch {
		return new URL(pathOrUrl, siteUrl).toString();
	}
};
const canonicalUrl = absoluteUrl(withBase(normalizePath(canonicalPath ?? currentPath)));
const socialImagePath = image
	? image.startsWith('http://') || image.startsWith('https://')
		? image
		: withBase(image)
	: brandLogoSrc;
const socialImageUrl = absoluteUrl(socialImagePath);
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': ['Organization', 'Church'],
	name: siteName,
	url: absoluteUrl(base + '/'),
	logo: absoluteUrl(brandLogoSrc),
	description: metaDescription,
	address: {
		'@type': 'PostalAddress',
		streetAddress: footerAddressLines[0],
		addressLocality: 'Sachse',
		addressRegion: 'TX',
		postalCode: '75048',
		addressCountry: 'US',
	},
	openingHours: footerServiceTime,
	sameAs: footerSocialLinks.map((link) => link.url),
};

const navItems: NavItem[] = [
	{ label: 'New Here?', href: '/new-here/' },
	{
		label: 'Who We Are',
		children: [
			{ label: 'Our Story', href: '/our-story/' },
			{ label: 'Our Vision & Values', href: '/our-vision/' },
			{ label: 'Our Leadership', href: '/leadership/' },
		],
	},
	{
		label: 'Service',
		children: [
			{ label: 'Service Time & Location', href: '/service-times-locations/' },
			{ label: 'Message Series', href: '/series/' },
		],
	},
	{
		label: 'Join In!',
		children: [
			{ label: 'MeetUps', href: '/meetups/' },
			{ label: 'Kids & Youth', href: '/kids-youth/' },
			{ label: 'Community Meals', href: '/community-meal/' },
			{ label: 'Get Involved', href: '/get-involved/' },
		],
	},
	{
		// TODO: Giving links to ChurchCenter (third-party giving platform). Cannot be reproduced locally.
		// When this site goes live, confirm the ChurchCenter subdomain and modal param are still correct.
		label: 'Giving',
		href: 'https://thetabletx.churchcenter.com/giving?open-in-church-center-modal=true',
		external: true,
	},
	{ label: 'Merch', href: '/merch/' },
	{
		label: 'Connect With Us',
		children: [
			{ label: 'Sign Up for Our Newsletter', href: '/sign-up-for-our-newsletter/' },
			{ label: 'Contact Us', href: '/contact-us/' },
		],
	},
	{ label: 'Get Involved', href: '/get-involved/' },
];

const isActive = (href: string) => currentPath === href;
const hasActiveChild = (item: NavItem) => item.children?.some((child) => isActive(child.href)) ?? false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
		<link rel="icon" href={base + '/favicon.ico'} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
		<meta
			name="description"
			content={metaDescription}
		/>
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:site_name" content={siteName} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		{googleTagManagerId && (
			<script
				is:inline
				set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(googleTagManagerId)});`}
			/>
		)}
		{directGoogleAnalyticsId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(directGoogleAnalyticsId)}`} />
				<script
					is:inline
					set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(directGoogleAnalyticsId)});`}
				/>
			</>
		)}
		<title>{title}</title>
	</head>
	<body>
		{googleTagManagerId && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(googleTagManagerId)}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
					title="Google Tag Manager"
				></iframe>
			</noscript>
		)}
		<div class="page-shell">
			<div class="header-wrap">
			<header class="site-header">
				<div class="brand-wrap">
					<a class="brand brand-logo-link" href={base + '/'} aria-label={siteName}>
						<img class="brand-logo" src={brandLogoSrc} alt={siteName} width="720" height="236" />
					</a>
					<p class="tagline">A church community in Sachse, Texas.</p>
				</div>
				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
					Menu
				</button>
				<nav class="site-nav desktop-nav" aria-label="Primary">
					<ul>
						{navItems.map((item, index) => (
							<li
								class:list={[
									item.children && 'has-children',
									((item.href && isActive(item.href)) || hasActiveChild(item)) && 'is-active',
								]}
							>
								{item.href ? (
									<a
										href={item.external ? item.href : base + item.href}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noreferrer' : undefined}
									>
										{item.label}
									</a>
								) : (
									<details class="desktop-group" open={hasActiveChild(item)}>
										<summary class="nav-trigger">{item.label}</summary>
										<ul class="submenu" id={`submenu-${index}`}>
											{item.children?.map((child) => (
												<li class:list={[isActive(child.href) && 'is-active']}>
													<a href={base + child.href}>{child.label}</a>
												</li>
											))}
										</ul>
									</details>
								)}
							</li>
						))}
					</ul>
				</nav>
			</header>

			<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile Primary" hidden>
				<ul>
					{navItems.map((item) => (
						<li>
							{item.children ? (
								<details open={hasActiveChild(item)}>
									<summary>{item.label}</summary>
									<ul class="mobile-submenu">
										{item.children.map((child) => (
											<li class:list={[isActive(child.href) && 'is-active']}>
												<a href={base + child.href}>{child.label}</a>
											</li>
										))}
									</ul>
								</details>
							) : (
								<a
									href={item.external ? item.href : base + item.href}
									target={item.external ? '_blank' : undefined}
									rel={item.external ? 'noreferrer' : undefined}
								>
									{item.label}
								</a>
							)}
						</li>
					))}
				</ul>
			</nav>
			</div><!-- /.header-wrap -->

			<main class="site-main">
				<slot />
			</main>

			<footer class="site-footer" aria-labelledby="site-footer-title">
				<div class="footer-brand">
					<p class="footer-title" id="site-footer-title">
						<img class="footer-logo" src={brandLogoSrc} alt={siteName} width="720" height="236" />
					</p>
					<p class="footer-tagline">{siteTagline}</p>
				</div>
				<div class="footer-grid">
					<div class="footer-section">
						<p class="footer-label">Location</p>
						<address class="footer-address">
							{footerAddressLines.map((line) => (
								<span>{line}</span>
							))}
						</address>
					</div>
					<div class="footer-section">
						<p class="footer-label">Service Time</p>
						<p class="footer-text">{footerServiceTime}</p>
					</div>
					<div class="footer-section">
						<p class="footer-label">Social</p>
						{footerSocialLinks.length > 0 ? (
							<ul class="footer-social-links">
								{footerSocialLinks.map((link) => (
									<li>
										<a href={link.url} target="_blank" rel="noreferrer">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						) : (
							<p class="footer-text">Follow us online.</p>
						)}
					</div>
				</div>
				<div class="footer-meta">
					<p aria-label={`Copyright ${footerCopyrightYear} ${siteName}`}>Copyright {footerCopyrightYear}</p>
					<a href={privacyHref}>Privacy</a>
				</div>
			</footer>
		</div>

		<script is:inline>
			const toggle = document.querySelector('.menu-toggle');
			const mobileNav = document.querySelector('#mobile-nav');
			const closeMobileNav = () => {
				if (!toggle || !mobileNav) return;
				toggle.setAttribute('aria-expanded', 'false');
				mobileNav.hidden = true;
			};

			toggle?.addEventListener('click', () => {
				if (!mobileNav) return;
				const next = toggle.getAttribute('aria-expanded') !== 'true';
				toggle.setAttribute('aria-expanded', String(next));
				mobileNav.hidden = !next;
			});

			mobileNav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					if (window.innerWidth <= 900) closeMobileNav();
				});
			});

			window.addEventListener('resize', () => {
				if (window.innerWidth > 900) closeMobileNav();
			});

			const desktopGroups = Array.from(document.querySelectorAll('.desktop-group'));
			const syncDesktopGroup = (group) => {
				const submenu = group.querySelector('.submenu');
				if (submenu instanceof HTMLElement) submenu.style.display = group.open ? 'block' : 'none';
			};

			const closeDesktopGroups = () => {
				desktopGroups.forEach((group) => {
					group.open = false;
					syncDesktopGroup(group);
				});
			};

			desktopGroups.forEach((group) => {
				syncDesktopGroup(group);
				group.addEventListener('toggle', () => syncDesktopGroup(group));
				const summary = group.querySelector('summary');
				summary?.addEventListener('click', (event) => {
					event.preventDefault();
					const next = !group.open;
					closeDesktopGroups();
					group.open = next;
					syncDesktopGroup(group);
				});
				group.addEventListener('mouseenter', () => {
					if (window.innerWidth <= 900) return;
					closeDesktopGroups();
					group.open = true;
					syncDesktopGroup(group);
				});
			});

			document.addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('.desktop-nav')) return;
				closeDesktopGroups();
			});

		</script>
	</body>
</html>

<style>
	/* ── Design System Tokens ── */
	:root {
		/* Brand (mode-agnostic) */
		--brand-teal:        #2f777c;
		--brand-teal-dark:   #213034;
		--brand-teal-deeper: #3d5c64;
		--brand-rust:        #9e3f31;
		--brand-coral:       #d65a42;
		--brand-coral-light: #e07a62;
		--brand-cream:       #efe2ca;

		/* Light mode UI */
		--bg:             #f3ede4;
		--bg-surface:     rgba(255, 252, 247, 0.92);
		--bg-raised:      #efe8dd;
		--border:         rgba(33, 48, 52, 0.12);
		--text-primary:   #213034;
		--text-body:      #334446;
		--text-secondary: #4e5d5c;
		--text-muted:     #7a9090;
		--link:           #9e3f31;
		--link-hover:     #d65a42;
		--radius-card:    28px;
		--radius-sm:      18px;
		--shadow-card:    0 18px 40px rgba(33, 48, 52, 0.08);
		--shadow-sm:      0 16px 34px rgba(33, 48, 52, 0.06);

		/* Legacy aliases — keep existing page code working */
		--cream:       var(--bg);
		--sand:        var(--bg-raised);
		--ink:         var(--text-primary);
		--muted:       var(--text-secondary);
		--accent:      var(--brand-coral);
		--accent-dark: var(--brand-rust);
		--teal:        var(--brand-teal);
		--card:        var(--bg-surface);
		--line:        var(--border);
	}

	[data-theme='dark'] {
		--bg:             #1e2022;
		--bg-surface:     #272a2d;
		--bg-raised:      #2f3336;
		--border:         rgba(255, 255, 255, 0.08);
		--text-primary:   #e8e4de;
		--text-body:      #c8c4be;
		--text-secondary: #9da4a8;
		--text-muted:     #636b70;
		--link:           #d65a42;
		--link-hover:     #e07a62;
		--shadow-card:    0 18px 40px rgba(0, 0, 0, 0.3);
		--shadow-sm:      0 16px 34px rgba(0, 0, 0, 0.2);
	}

	html {
		background:
			radial-gradient(circle at top left, rgba(214, 90, 66, 0.18), transparent 30%),
			radial-gradient(circle at top right, rgba(47, 119, 124, 0.18), transparent 32%),
			linear-gradient(180deg, #fbf6ef 0%, var(--bg) 100%);
		color: var(--text-primary);
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
	}

	body {
		margin: 0;
		min-height: 100vh;
	}

	a {
		color: inherit;
	}

	.page-shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.header-wrap {
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem clamp(1.25rem, 3vw, 2.5rem);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(10px);
		background: rgba(251, 246, 239, 0.88);
	}

	.brand-wrap {
		display: grid;
		gap: 0.15rem;
	}

	.brand {
		font-size: clamp(1.6rem, 2.2vw, 2.2rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.brand-logo-link {
		display: inline-flex;
		align-items: center;
		width: min(15rem, 48vw);
		line-height: 0;
	}

	.brand-logo,
	.footer-logo {
		display: block;
		width: 100%;
		height: auto;
	}

	.footer-logo {
		max-width: 12rem;
	}

	.tagline {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.site-nav,
	.mobile-nav {
		font-family: 'Trebuchet MS', sans-serif;
	}

	.site-nav ul,
	.mobile-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.desktop-nav > ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.desktop-nav li {
		position: relative;
	}

	.site-nav a,
	.nav-trigger,
	.mobile-nav a,
	.mobile-nav summary {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.7rem;
		border-radius: 999px;
		text-decoration: none;
		color: var(--accent-dark);
		font-weight: 600;
		cursor: pointer;
	}

	.nav-trigger {
		color: var(--ink);
		list-style: none;
	}

	.desktop-group > summary::-webkit-details-marker {
		display: none;
	}

	.desktop-group > .submenu {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 14rem;
		padding: 0.45rem;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(251, 246, 239, 0.98);
		box-shadow: 0 18px 34px rgba(33, 48, 52, 0.08);
		display: none;
	}

	.desktop-group[open] > .submenu,
	.desktop-nav li:hover > .desktop-group > .submenu,
	.desktop-nav li:focus-within > .desktop-group > .submenu {
		display: block;
	}

	.desktop-nav .submenu a {
		display: flex;
		border-radius: 14px;
	}

	.is-active > a,
	.is-active > .desktop-group > .nav-trigger,
	.submenu .is-active > a,
	.mobile-submenu .is-active > a {
		background: rgba(214, 90, 66, 0.12);
	}

	.menu-toggle {
		display: none;
		padding: 0.75rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(251, 246, 239, 0.92);
		color: var(--ink);
		font: 700 0.92rem/1 'Trebuchet MS', sans-serif;
	}

	.mobile-nav {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		padding: 0 1.25rem 1rem;
		background: rgba(251, 246, 239, 0.98);
		border-bottom: 1px solid var(--line);
		box-shadow: 0 8px 24px rgba(33, 48, 52, 0.1);
	}

	.mobile-nav[hidden] {
		display: none !important;
	}

	.mobile-nav > ul {
		display: grid;
		gap: 0.5rem;
	}

	.mobile-nav details {
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(255, 252, 247, 0.92);
		padding: 0.25rem;
	}

	.mobile-nav li > a {
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--line);
		background: rgba(255, 252, 247, 0.92);
	}

	.mobile-nav summary {
		list-style: none;
	}

	.mobile-nav summary::-webkit-details-marker {
		display: none;
	}

	.mobile-submenu {
		display: grid;
		gap: 0.35rem;
		padding: 0.35rem;
	}

	.mobile-submenu a {
		width: 100%;
		box-sizing: border-box;
	}

	.site-main {
		flex: 1;
		padding: clamp(1.25rem, 4vw, 3rem);
	}

	.site-footer {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem) 2rem;
		border-top: 1px solid var(--line);
		background: rgba(251, 246, 239, 0.88);
	}

	.footer-brand {
		display: grid;
		gap: 0.35rem;
		max-width: 42rem;
	}

	.footer-title {
		margin: 0;
		font: 700 clamp(1.15rem, 1.8vw, 1.45rem) / 1.1 'Trebuchet MS', 'Segoe UI', sans-serif;
		line-height: 0;
		width: min(12rem, 60vw);
	}

	.footer-tagline {
		margin: 0;
		color: var(--muted);
		line-height: 1.6;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.footer-section {
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}

	.footer-label {
		margin: 0;
		font: 700 0.8rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-dark);
	}

	.footer-address {
		display: grid;
		gap: 0.2rem;
		font-style: normal;
		line-height: 1.55;
		color: var(--ink);
	}

	.footer-address span,
	.footer-text,
	.footer-meta p {
		margin: 0;
	}

	.footer-social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

