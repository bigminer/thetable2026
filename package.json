{
  "name": "thetabletx",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:tailscale": "bash scripts/dev-tailscale.sh",
    "build": "astro build",
    "preview": "node scripts/start.mjs",
    "astro": "astro",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "fetch": "yt-dlp --write-auto-subs --sub-lang en --skip-download --write-info-json --download-archive data/transcripts/archive.txt --break-on-existing --match-filters \"title !*= 📱\" --output 'data/transcripts/raw/%(upload_date>%Y-%m-%d)s-%(id)s.%(ext)s' --convert-subs vtt --ignore-no-formats-error",
    "transcribe": "node --env-file-if-exists=.env --import tsx scripts/transcribe-missing.ts",
    "make-stubs": "node --import tsx scripts/make-stubs.ts",
    "enrich-titles": "node --import tsx scripts/enrich-titles.ts",
    "detect-bounds": "node --import tsx scripts/detect-bounds.ts",
    "make-descriptions": "node --env-file-if-exists=.env --import tsx scripts/make-descriptions.ts",
    "automation:dry-run": "node --import tsx scripts/automation-dry-run.ts",
    "youtube:dry-run": "node --import tsx scripts/youtube-discovery.ts",
    "automation:ingest-one-series": "node --import tsx scripts/ingest-new-media.ts",
    "start": "node scripts/start.mjs",
    "test": "node --import tsx --test scripts/**/*.test.ts src/**/*.test.ts",
    "test:smoke": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@astrojs/node": "^10.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.8",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.0.0",
    "openai": "^6.34.0",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.21.0"
  }
}
