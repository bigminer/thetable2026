{
  "name": "tablefresh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ask": "node --env-file=.env --import tsx scripts/ask.ts",
    "fetch": "yt-dlp --write-auto-subs --sub-lang en --skip-download --write-info-json --download-archive scripts/transcripts/archive.txt --output 'scripts/transcripts/raw/%(upload_date>%Y-%m-%d)s-%(id)s.%(ext)s' --convert-subs vtt",
    "transcribe": "node --env-file=.env --import tsx scripts/transcribe-missing.ts",
    "make-stubs": "node --import tsx scripts/make-stubs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "astro": "^6.1.8",
    "openai": "^6.34.0",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
