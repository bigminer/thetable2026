---
/* A compact masthead with wide editorial menus. It keeps the print-poster voice
   while making the visitor journeys easier to scan. See design.md. */
import { site } from '../config/site';
import { navigation as navItems } from '../config/navigation';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteName = site.title;
const brandLogoSrc = base + '/attachments/branding/the-table-written-logo.png';
const mastLine = `${site.serviceTime} · ${site.addressLines[0]}, ${site.addressLines[1]}`;
const featuredItem = navItems.find((item) => item.featured);
const primaryItems = navItems.filter((item) => !item.featured);
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const currentPath = base && rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;
const isActive = (href: string) => currentPath === href;
const hasActiveChild = (item: (typeof navItems)[number]) => item.children?.some(child => isActive(child.href)) ?? false;
---

<div class="header-wrap">
	<header class="site-header">
		<div class="brand-lockup">
			<a class="brand-logo-link" href={base + '/'} aria-label={`${siteName} home`}>
				<img class="brand-logo" src={brandLogoSrc} alt={siteName} width="720" height="236" fetchpriority="high" />
			</a>
			<p class="mast-line">{mastLine}</p>
		</div>

		<nav class="site-nav desktop-nav" aria-label="Primary">
			<ul>
				{primaryItems.map((item, index) => (
					<li
						class:list={[
							item.children && 'has-children',
							((item.href && isActive(item.href)) || hasActiveChild(item)) && 'is-active',
						]}
					>
						{item.href ? (
							<a
								href={item.external ? item.href : base + item.href}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noreferrer' : undefined}
							>
								{item.label}
							</a>
						) : (
							<details class="desktop-group">
								<summary class="nav-trigger">{item.label}</summary>
								<ul class="submenu" id={`submenu-${index}`} aria-label={`${item.label} links`}>
									{item.children?.map((child) => (
										<li class:list={[isActive(child.href) && 'is-active']}>
											<a href={base + child.href}>
												<span class="submenu-label">{child.label}</span>
												<span class="submenu-description">{child.description}</span>
											</a>
										</li>
									))}
								</ul>
							</details>
						)}
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			{featuredItem?.href && (
				<a
					class:list={['giving-link', isActive(featuredItem.href) && 'is-active']}
					href={base + featuredItem.href}
				>{featuredItem.label}</a>
			)}
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
				<span class="menu-toggle-label">Menu</span>
				<span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</header>

	<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile Primary" hidden>
		<ul>
			{primaryItems.map((item) => (
				<li>
					{item.children ? (
						<details open={hasActiveChild(item)}>
							<summary>{item.label}</summary>
							<ul class="mobile-submenu">
								{item.children.map((child) => (
									<li class:list={[isActive(child.href) && 'is-active']}>
										<a href={base + child.href}>{child.label}</a>
									</li>
								))}
							</ul>
						</details>
					) : (
						<a
							href={item.external ? item.href : base + item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noreferrer' : undefined}
						>
							{item.label}
						</a>
					)}
				</li>
			))}
		</ul>
	</nav>
</div>

<script is:inline>
	const toggle = document.querySelector('.menu-toggle');
	const mobileNav = document.querySelector('#mobile-nav');
	const NAV_BREAKPOINT = 960;
	const closeMobileNav = () => {
		if (!toggle || !mobileNav) return;
		toggle.setAttribute('aria-expanded', 'false');
		mobileNav.hidden = true;
	};
	const openMobileNav = () => {
		if (!toggle || !mobileNav) return;
		toggle.setAttribute('aria-expanded', 'true');
		mobileNav.hidden = false;
	};

	toggle?.addEventListener('click', () => {
		if (!mobileNav) return;
		const next = toggle.getAttribute('aria-expanded') !== 'true';
		if (next) openMobileNav();
		else closeMobileNav();
	});

	mobileNav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (window.innerWidth <= NAV_BREAKPOINT) closeMobileNav();
		});
	});

	window.addEventListener('resize', () => {
		if (window.innerWidth > NAV_BREAKPOINT) closeMobileNav();
	});

	const desktopGroups = Array.from(document.querySelectorAll('.desktop-group'));

	const closeDesktopGroups = () => {
		desktopGroups.forEach((group) => {
			group.open = false;
		});
	};

	desktopGroups.forEach((group) => {
		group.addEventListener('toggle', () => {
			if (!group.open) return;
			desktopGroups.forEach((otherGroup) => {
				if (otherGroup !== group) otherGroup.open = false;
			});
		});
		group.addEventListener('mouseenter', () => {
			if (window.matchMedia('(hover: none)').matches) return;
			if (window.innerWidth <= NAV_BREAKPOINT) return;
			group.open = true;
		});
	});

	document.addEventListener('click', (event) => {
		if (event.target instanceof Element && event.target.closest('.desktop-nav')) return;
		closeDesktopGroups();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (toggle?.getAttribute('aria-expanded') === 'true') {
			closeMobileNav();
			toggle.focus();
			return;
		}
		const openGroup = desktopGroups.find((group) => group.open);
		if (!openGroup) return;
		openGroup.open = false;
		openGroup.querySelector('summary')?.focus();
	});
</script>
