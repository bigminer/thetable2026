---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentBlocks from '../components/ContentBlocks.astro';

const home = await getEntry('pages', 'home.md');

if (!home) {
  throw new Error('Home page content entry is missing.');
}

const seo = home.data.seo ?? {};
const { blocks } = home.data;
---

<BaseLayout
  title={seo.title ?? home.data.title}
  description={seo.description ?? home.data.description ?? 'The Table Church'}
  canonicalPath={home.data.url}
  noindex={seo.noindex}
>
  <main class="page page--content">
    <ContentBlocks blocks={blocks} />
  </main>
</BaseLayout>
