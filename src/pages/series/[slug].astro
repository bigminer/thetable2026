---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug } from '../../lib/entry-slug';

export async function getStaticPaths() {
  const seriesEntries = await getCollection('series', ({ data }) => !data.draft);

  return seriesEntries.map((series) => ({
    params: { slug: entrySlug(series) },
    props: { series },
  }));
}

const { series } = Astro.props;
const allMessages = await getCollection('messages', ({ data }) => !data.draft);
const messages = allMessages
  .filter((entry) => entrySlug(entry.data.series ?? { id: '' }) === entrySlug(series))
  .sort((left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf());

const publishedFrom = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(series.data.startDate);
---

<BaseLayout
  title={series.data.title}
  description={series.data.summary}
  canonicalPath={`/series/${entrySlug(series)}/`}
>
  <main class="page stack">
    <section class="series-hero stack">
      {series.data.image && <img class="series-hero__image" src={series.data.image.src} alt={series.data.image.alt} />}
      <div class="stack">
        <p class="eyebrow">Series</p>
        <h1>{series.data.title}</h1>
        <p class="lede">{series.data.summary}</p>
        <p class="series-meta">First published {publishedFrom}</p>
      </div>
    </section>

    <section class="grid grid--2">
      <article class="panel stack">
        <p class="eyebrow">Overview</p>
        <h2>{series.data.title}</h2>
        <p>{series.data.summary}</p>
        <div class="actions">
          <a class="button button--primary" href="https://anchor.fm/thetabletx/" target="_blank" rel="noreferrer">
            Anchor
          </a>
          <a class="button button--secondary" href="https://open.spotify.com/show/0Q36Z4OhAvsfDLUel3PtCL/" target="_blank" rel="noreferrer">
            Spotify
          </a>
          <a class="button button--secondary" href="https://podcasts.apple.com/us/podcast/the-table-tx/id1489269613" target="_blank" rel="noreferrer">
            Apple Podcasts
          </a>
        </div>
      </article>

      <aside class="panel stack">
        <p class="eyebrow">Messages</p>
        <h2>{messages.length} episode{messages.length === 1 ? '' : 's'}</h2>
        <div class="stack">
          {messages.length > 0 ? (
            <div class="episode-table">
              {messages.map((entry) => (
                <article class="episode-table__row">
                  <div class="episode-table__date">
                    {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(entry.data.publishedAt)}
                  </div>
                  <div class="episode-table__body">
                    <h3>
                      <a href={`/podcast/${entrySlug(entry)}/`}>{entry.data.title}</a>
                    </h3>
                    <p>{entry.data.summary}</p>
                    <p class="episode-table__meta">
                      {(entry.data.speakers ?? [])
                        .map((speaker) => speaker.data?.name ?? speaker.name ?? entrySlug(speaker))
                        .join(' · ')}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p>No messages have been linked to this series yet.</p>
          )}
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .series-hero {
    display: grid;
    gap: 1rem;
  }

  .series-hero__image {
    width: 100%;
    display: block;
    border-radius: 8px;
  }

  .series-meta,
  .episode-table__meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .episode-table {
    display: grid;
    gap: 0.75rem;
  }

  .episode-table__row {
    display: grid;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .episode-table__date {
    color: var(--muted);
    font-weight: 700;
    letter-spacing: 0;
  }

  .episode-table__body {
    display: grid;
    gap: 0.35rem;
  }

  @media (min-width: 48rem) {
    .episode-table__row {
      grid-template-columns: 5rem minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
