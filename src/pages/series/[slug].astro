---
export const prerender = true;
/* Hallmark · macrostructure: Ledger · design-system: design.md · designed-as-app
 * Slate masthead → full-bleed series art → cream body → message ledger.
 * The message rows keep the church's own date-left / label-right rhythm.
 */
import { getCollection, render } from 'astro:content';
import { fallbackSlug, resolveAsset, safeGetCollection } from '../../lib/content';
import { formatMessageDate, getMessagesForSeries } from '../../lib/podcast';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
	const entries = await safeGetCollection(() => getCollection('series', ({ data }) => !data.draft));
	const messages = await safeGetCollection(() => getCollection('messages', ({ data }) => !data.draft));
	return entries.map((entry) => ({
		params: { slug: fallbackSlug(entry.data.slug, entry.id) },
		props: { entry, messages: getMessagesForSeries(messages, fallbackSlug(entry.data.slug, entry.id)) },
	}));
}

const { entry, messages } = Astro.props;
const { Content } = await render(entry);
const podcastLinks = site.podcastLinks;
const seriesArt = entry.data.featuredImage ? resolveAsset(entry.data.featuredImage) : undefined;
---

<Layout title={`${entry.data.title} | The Table Church`} description={entry.data.description}>
	<article class="series-entry">
		<header class="series-mast band band-slate">
			<h1>{entry.data.title}</h1>
			<p class="lede">{entry.data.description}</p>

			{(entry.data.speaker || entry.data.scripture) && (
				<dl class="mast-meta">
					{entry.data.speaker && (
						<div>
							<dt>Speaker</dt>
							<dd>{entry.data.speaker}</dd>
						</div>
					)}
					{entry.data.scripture && (
						<div>
							<dt>Scripture</dt>
							<dd>{entry.data.scripture}</dd>
						</div>
					)}
				</dl>
			)}

			{podcastLinks.length > 0 && (
				<div class="subscribe">
					<p class="subscribe-label">Subscribe</p>
					<ul class="subscribe-list">
						{podcastLinks.map((link) => (
							<li><a href={link.url} target="_blank" rel="noreferrer">{link.label}</a></li>
						))}
					</ul>
				</div>
			)}
		</header>

		{seriesArt && (
			<figure class="series-figure">
				<img src={seriesArt} alt={entry.data.featuredImageAlt ?? ''} fetchpriority="high" />
			</figure>
		)}

		<div class="series-body band band-cream">
			<div class="body"><Content /></div>

			{messages.length > 0 && (
				<section class="episodes" aria-labelledby="episodes-title">
					<h2 id="episodes-title">Messages in this series</h2>
					<ol class="episode-ledger">
						{messages.map((message) => (
							<li class="episode-row">
								<p class="episode-date">{formatMessageDate(message.data.date)}</p>
								<div class="episode-copy">
									<h3>{message.data.title}</h3>
									{message.data.speaker && <p class="episode-speaker">{message.data.speaker}</p>}
									{message.data.description && (
										<p class="episode-desc">{message.data.description}</p>
									)}
								</div>
								<div class="episode-actions">
									{message.data.sourceUrl ? (
										<a class="episode-link" href={message.data.sourceUrl} target="_blank" rel="noreferrer">Watch</a>
									) : (
										<span class="episode-link is-unavailable">Unavailable</span>
									)}
									{message.data.podcastUrl?.trim() && (
										<a class="episode-link" href={message.data.podcastUrl.trim()} target="_blank" rel="noreferrer">Listen</a>
									)}
								</div>
							</li>
						))}
					</ol>
				</section>
			)}
		</div>
	</article>
</Layout>

<style>
	.series-mast {
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	.series-mast h1 {
		max-width: 20ch;
		font-size: var(--text-display-s);
		font-weight: 800;
	}

	.series-mast .lede {
		margin-top: var(--space-lg);
		max-width: 52ch;
		font-size: var(--text-md);
		line-height: var(--leading-body);
		color: var(--color-muted-on-band);
	}

	.mast-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md) var(--space-2xl);
		margin: var(--space-xl) 0 0;
	}

	.mast-meta dt {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--color-muted-on-band);
	}

	.mast-meta dd {
		margin: var(--space-2xs) 0 0;
		font-size: var(--text-base);
	}

	.subscribe {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm) var(--space-lg);
		margin-top: var(--space-xl);
		padding-top: var(--space-md);
		border-top: var(--rule-hair) solid var(--color-rule-on-band);
	}

	.subscribe-label {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--color-muted-on-band);
	}

	.subscribe-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm) var(--space-lg);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.subscribe-list a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-base);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		text-decoration: underline;
		text-decoration-thickness: var(--rule-hair);
		text-underline-offset: 2px;
		transition: text-decoration-thickness var(--dur-short) var(--ease-out),
			text-decoration-color var(--dur-short) var(--ease-out);
	}

	.subscribe-list a:hover,
	.subscribe-list a:focus-visible {
		text-decoration-thickness: 2px;
		text-decoration-color: var(--color-accent);
	}

	.series-figure {
		margin: 0;
	}

	.series-figure img {
		display: block;
		width: 100%;
		max-height: 44vh;
		object-fit: contain;
		background: var(--color-band-2);
	}

	/* ── Body ───────────────────────────────────────────────────────────── */

	.series-body {
		padding-block: var(--space-3xl) var(--space-4xl);
	}

	.body :global(p),
	.body :global(li) {
		max-width: var(--measure);
		margin: 0 0 var(--space-md);
		font-size: var(--text-md);
		line-height: var(--leading-body);
		color: var(--color-ink-2);
	}

	.body :global(a) {
		color: var(--color-accent-deep);
		text-decoration: underline;
		text-decoration-thickness: var(--rule-hair);
		text-underline-offset: 2px;
	}

	/* ── Message ledger ─────────────────────────────────────────────────── */

	.episodes {
		margin-top: var(--space-3xl);
	}

	.episodes h2 {
		margin: 0 0 var(--space-lg);
		font-size: var(--text-2xl);
		color: var(--color-ink);
	}

	.episode-ledger {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: var(--rule-heavy) solid var(--color-ink);
	}

	.episode-row {
		display: grid;
		grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) auto;
		gap: var(--space-sm) var(--space-xl);
		align-items: baseline;
		padding-block: var(--space-lg);
		border-bottom: var(--rule-hair) solid var(--color-rule);
	}

	.episode-date {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--text-md);
		letter-spacing: var(--track-display);
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--color-ink);
	}

	.episode-copy h3 {
		margin: 0;
		font-size: var(--text-lg);
		line-height: 1.06;
		color: var(--color-ink);
	}

	.episode-speaker {
		margin: var(--space-2xs) 0 0;
		font-size: var(--text-base);
		color: var(--color-muted);
	}

	/* Summary sits under the title at a narrower measure than the row, so the
	   ledger keeps its date-left rhythm instead of reading as a wall of prose. */
	.episode-desc {
		margin: var(--space-xs) 0 0;
		max-width: 54ch;
		font-size: var(--text-base);
		line-height: 1.5;
		color: var(--color-ink-2);
	}

	.episode-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
	}

	.episode-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-base);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-accent-deep);
		text-decoration: underline;
		text-decoration-thickness: var(--rule-hair);
		text-underline-offset: 2px;
		transition: text-decoration-thickness var(--dur-short) var(--ease-out);
	}

	.episode-link:hover,
	.episode-link:focus-visible {
		text-decoration-thickness: 3px;
	}

	.episode-link:active {
		color: var(--color-accent);
	}

	.episode-link.is-unavailable {
		color: var(--color-muted);
		text-decoration: none;
		cursor: not-allowed;
	}

	@media (max-width: 60rem) {
		.series-body {
			padding-block: var(--space-2xl) var(--space-3xl);
		}
	}

	@media (max-width: 48rem) {
		.episode-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-xs);
		}

		.series-mast {
			padding-block: var(--space-xl) var(--space-2xl);
		}

		.series-mast h1 {
			max-width: none;
		}
	}
</style>
