---
export const prerender = true;
/* Hallmark · macrostructure: Ledger · design-system: design.md · designed-as-app
 * The row pattern from the church's own "Upcoming Events" graphic: a fixed key
 * column on the left, a hairline rule per row, the label on the right. Replaces
 * the previous card grid.
 */
import { getCollection } from 'astro:content';
import { fallbackSlug, resolveAsset, safeGetCollection } from '../../lib/content';
import { getMessagesForSeries, sortSeriesEntries } from '../../lib/podcast';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';

const messages = await safeGetCollection(() => getCollection('messages', ({ data }) => !data.draft));
const entries = sortSeriesEntries(
	await safeGetCollection(() => getCollection('series', ({ data }) => !data.draft)),
	messages,
);
const podcastLinks = site.podcastLinks;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Series | The Table Church" description="Browse message series from The Table Church.">
	<section class="series-mast band band-slate">
		<h1>Message Series</h1>
		<p class="lede">Choose one of our series to listen to a message, share with a friend, or revisit later.</p>
		{podcastLinks.length > 0 && (
			<div class="subscribe">
				<p class="subscribe-label">Subscribe</p>
				<ul class="subscribe-list">
					{podcastLinks.map((link) => (
						<li>
							<a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
						</li>
					))}
				</ul>
			</div>
		)}
	</section>

	<section class="series-index band band-cream" aria-label="Series list">
		{entries.length > 0 ? (
			<ol class="series-ledger">
				{entries.map((entry, index) => {
					const seriesSlug = fallbackSlug(entry.data.slug, entry.id);
					const messageCount = getMessagesForSeries(messages, seriesSlug).length;
					const href = `${base}/series/${seriesSlug}/`;

					return (
						<li class="series-row">
							<a class="series-art" href={href} tabindex="-1" aria-hidden="true">
								{entry.data.featuredImage ? (
									<img src={resolveAsset(entry.data.featuredImage)} alt="" loading={index < 2 ? undefined : 'lazy'} />
								) : (
									<span class="series-art-blank">{String(index + 1).padStart(2, '0')}</span>
								)}
							</a>
							<div class="series-copy">
								<h2><a href={href}>{entry.data.title}</a></h2>
								<p class="series-desc">{entry.data.description}</p>
								{messageCount > 0 && (
									<p class="series-count">
										{messageCount} message{messageCount === 1 ? '' : 's'}
									</p>
								)}
							</div>
						</li>
					);
				})}
			</ol>
		) : (
			<p class="empty-state">No series entries have been migrated yet.</p>
		)}
	</section>
</Layout>

<style>
	.series-mast {
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	.series-mast h1 {
		font-size: var(--text-display-s);
		font-weight: 800;
	}

	.series-mast .lede {
		margin-top: var(--space-lg);
		max-width: 52ch;
		font-size: var(--text-md);
		line-height: var(--leading-body);
		color: var(--color-muted-on-band);
	}

	.subscribe {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm) var(--space-lg);
		margin-top: var(--space-xl);
		padding-top: var(--space-md);
		border-top: var(--rule-hair) solid var(--color-rule-on-band);
	}

	.subscribe-label {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--color-muted-on-band);
	}

	.subscribe-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm) var(--space-lg);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.subscribe-list a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-base);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		text-decoration: underline;
		text-decoration-thickness: var(--rule-hair);
		text-underline-offset: 2px;
		transition: text-decoration-thickness var(--dur-short) var(--ease-out),
			text-decoration-color var(--dur-short) var(--ease-out);
	}

	.subscribe-list a:hover,
	.subscribe-list a:focus-visible {
		text-decoration-thickness: 2px;
		text-decoration-color: var(--color-accent);
	}

	/* ── Ledger ─────────────────────────────────────────────────────────── */

	.series-index {
		padding-block: var(--space-2xl) var(--space-4xl);
	}

	.series-ledger {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: var(--rule-heavy) solid var(--color-ink);
	}

	.series-row {
		display: grid;
		grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
		gap: var(--space-lg) var(--space-2xl);
		align-items: start;
		padding-block: var(--space-xl);
		border-bottom: var(--rule-hair) solid var(--color-rule);
	}

	.series-art {
		display: block;
		line-height: 0;
		text-decoration: none;
	}

	.series-art img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: contain;
		background: var(--color-paper-2);
	}

	.series-art-blank {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 4 / 3;
		background: var(--color-paper-2);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--text-3xl);
		line-height: 1.04;
		color: var(--color-muted);
	}

	.series-copy h2 {
		margin: 0;
		font-size: var(--text-2xl);
		color: var(--color-ink);
	}

	.series-copy h2 a {
		text-decoration: underline;
		text-decoration-thickness: var(--rule-hair);
		text-decoration-color: var(--color-rule);
		text-underline-offset: 4px;
		transition: text-decoration-thickness var(--dur-short) var(--ease-out),
			text-decoration-color var(--dur-short) var(--ease-out);
	}

	.series-copy h2 a:hover,
	.series-copy h2 a:focus-visible {
		text-decoration-thickness: 3px;
		text-decoration-color: var(--color-accent);
	}

	.series-copy h2 a:active {
		color: var(--color-accent-deep);
	}

	.series-desc {
		margin: var(--space-sm) 0 0;
		max-width: var(--measure);
		font-size: var(--text-base);
		line-height: var(--leading-body);
		color: var(--color-ink-2);
	}

	.series-count {
		margin: var(--space-md) 0 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}

	.empty-state {
		margin: 0;
		padding-top: var(--space-lg);
		border-top: var(--rule-hair) solid var(--color-rule);
		color: var(--color-muted);
	}

	@media (max-width: 48rem) {
		.series-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-md);
		}

		.series-art {
			max-width: 20rem;
		}
	}
</style>
