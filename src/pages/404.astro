---
export const prerender = true;
/* Hallmark · design-system: design.md · designed-as-app */
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page Not Found | The Table Church" noindex={true}>
	<section class="not-found band band-slate">
		<h1>Page not found</h1>
		<p class="lede">This page doesn&rsquo;t exist or may have moved.</p>
		<a class="link" href={base + '/'}>Back to home</a>
	</section>
</Layout>

<script>
	// If a valid route was accessed without a trailing slash, add it and retry.
	const path = window.location.pathname;
	if (!path.endsWith('/')) {
		window.location.replace(path + '/' + window.location.search + window.location.hash);
	}
</script>

<style>
	.not-found {
		display: grid;
		align-content: center;
		gap: var(--space-lg);
		justify-items: start;
		min-height: 52vh;
		padding-block: var(--space-3xl);
	}

	.not-found h1 {
		max-width: 16ch;
		font-size: var(--text-display-s);
		font-weight: 800;
	}

	.lede {
		margin: 0;
		max-width: 46ch;
		font-size: var(--text-md);
		line-height: var(--leading-body);
		color: var(--color-muted-on-band);
	}
</style>
