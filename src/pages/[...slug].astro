---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentBlocks from '../components/ContentBlocks.astro';

export async function getStaticPaths() {
  const reservedPaths = new Set([
    '/',
    '/contact-us/',
    '/events/',
    '/get-involved/',
    '/giving/',
    '/series/',
    '/sign-up-for-our-newsletter/',
  ]);
  const pages = await getCollection('pages', ({ data }) => !data.draft);

  return pages
    .filter((page) => !reservedPaths.has(page.data.url))
    .map((page) => ({
      params: {
        slug: page.data.url.replace(/^\/|\/$/g, ''),
      },
      props: { page },
    }));
}

const { page } = Astro.props;
const seo = page.data.seo ?? {};
---

<BaseLayout
  title={seo.title ?? page.data.title}
  description={seo.description ?? page.data.description ?? 'The Table Church'}
  canonicalPath={seo.canonical ?? page.data.url}
  noindex={seo.noindex}
>
  <main class="page stack">
    {!page.data.blocks?.some((b: any) => b.type === 'hero') && (
      <header class="page-heading stack">
        <h1>{page.data.title}</h1>
      </header>
    )}
    <ContentBlocks blocks={page.data.blocks} />
  </main>
</BaseLayout>

<style>
  .page-heading {
    --stack-gap: 0.5rem;
  }
</style>
