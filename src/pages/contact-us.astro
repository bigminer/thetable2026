---
export const prerender = true;
import ContentSidebar from '../components/ContentSidebar.astro';
import Layout from '../layouts/Layout.astro';

---

<Layout
	title="Contact Us | The Table Church"
	description="Get in touch with someone from The Table Church in Sachse, TX."
>
	<article class="content-page">
		<header class="page-hero">
			<div class="hero-copy">
				<p class="eyebrow">Connect With Us</p>
				<h1>Contact Us</h1>
				<p class="lede">If you have a question or need to connect with someone from The Table TX, we'd love to hear from you.</p>
			</div>
		</header>

		<div class="content-grid">
			<section class="body">
				<p>How can we help? Fill out the form below and someone from The Table will be in touch.</p>

				<form id="contact-form" class="site-form" novalidate>
					<div class="hp-field" aria-hidden="true">
						<label for="hp-name">Leave this blank</label>
						<input type="text" id="hp-name" name="hp_name" tabindex="-1" autocomplete="off" />
					</div>

					<div class="form-row">
						<div class="field">
							<label for="firstName">First Name <span class="req">*</span></label>
							<input type="text" id="firstName" name="firstName" required autocomplete="given-name" />
						</div>
						<div class="field">
							<label for="lastName">Last Name <span class="req">*</span></label>
							<input type="text" id="lastName" name="lastName" required autocomplete="family-name" />
						</div>
					</div>

					<div class="field">
						<label for="email">Email <span class="req">*</span></label>
						<input type="email" id="email" name="email" required autocomplete="email" />
					</div>

					<div class="field">
						<label for="phone">Phone</label>
						<input type="tel" id="phone" name="phone" autocomplete="tel" />
					</div>

					<div class="field">
						<label for="message">Message</label>
						<textarea id="message" name="message" rows="5"></textarea>
					</div>

					<div class="form-footer">
						<button type="submit" class="submit-btn">Submit</button>
						<p class="form-status" aria-live="polite"></p>
					</div>
				</form>
			</section>

			<ContentSidebar />
		</div>
	</article>
</Layout>

<script>
const form = document.getElementById('contact-form') as HTMLFormElement;
const status = form?.querySelector('.form-status') as HTMLParagraphElement;
const btn = form?.querySelector('.submit-btn') as HTMLButtonElement;

form?.addEventListener('submit', async (e) => {
	e.preventDefault();
	btn.disabled = true;
	btn.textContent = 'Sending…';
	status.textContent = '';
	status.className = 'form-status';

	const data = {
		hp_name: (form.querySelector('[name="hp_name"]') as HTMLInputElement).value,
		firstName: (form.querySelector('[name="firstName"]') as HTMLInputElement).value,
		lastName: (form.querySelector('[name="lastName"]') as HTMLInputElement).value,
		email: (form.querySelector('[name="email"]') as HTMLInputElement).value,
		phone: (form.querySelector('[name="phone"]') as HTMLInputElement).value,
		message: (form.querySelector('[name="message"]') as HTMLTextAreaElement).value,
	};

	try {
		const res = await fetch('/api/contact', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data),
		});
		const json = await res.json();

		if (json.ok) {
			form.innerHTML = '<p class="success-msg">Thanks — we\'ll be in touch soon.</p>';
		} else {
			status.textContent = json.error ?? 'Something went wrong. Please try again.';
			status.classList.add('is-error');
			btn.disabled = false;
			btn.textContent = 'Submit';
		}
	} catch {
		status.textContent = 'Something went wrong. Please try again.';
		status.classList.add('is-error');
		btn.disabled = false;
		btn.textContent = 'Submit';
	}
});
</script>

<style>

	.content-page {
		display: grid;
		gap: 2rem;
	}

	.page-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		align-items: center;
	}

	.hero-copy { max-width: 44rem; }

	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--brand-rust);
		font: 700 0.82rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.2rem, 5vw, 4rem);
		line-height: 0.95;
	}

	.lede {
		margin: 0;
		color: var(--text-secondary);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.content-grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(280px, 0.95fr);
		gap: 1.5rem;
		align-items: start;
	}

	.body {
		line-height: 1.8;
	}

	.body p {
		color: var(--text-body);
		margin: 0 0 1.5rem;
	}

	/* Form */
	.site-form {
		display: grid;
		gap: 1.1rem;
		margin-top: 0.5rem;
	}

	.hp-field {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.field {
		display: grid;
		gap: 0.35rem;
	}

	.field label {
		font: 700 0.78rem/1.1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.req {
		color: var(--brand-rust);
	}

	.field input,
	.field textarea {
		width: 100%;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm, 8px);
		background: var(--bg-surface);
		color: var(--text-primary);
		font-size: 1rem;
		font-family: inherit;
		line-height: 1.5;
		transition: border-color 0.15s;
		box-sizing: border-box;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--brand-rust);
		box-shadow: 0 0 0 3px rgba(139, 58, 43, 0.12);
	}

	.field textarea {
		resize: vertical;
		min-height: 120px;
	}

	.form-footer {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.25rem;
	}

	.submit-btn {
		padding: 0.65rem 2rem;
		background: var(--brand-rust);
		color: #fff;
		border: none;
		border-radius: var(--radius-sm, 8px);
		font: 700 0.95rem/1 'Trebuchet MS', sans-serif;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: opacity 0.15s;
	}

	.submit-btn:hover { opacity: 0.85; }
	.submit-btn:disabled { opacity: 0.55; cursor: not-allowed; }

	.form-status {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.form-status.is-error { color: #c0392b; }

	:global(.success-msg) {
		padding: 1rem 1.25rem;
		background: rgba(139, 58, 43, 0.06);
		border-left: 3px solid var(--brand-rust);
		color: var(--text-body);
		font-size: 1.05rem;
		line-height: 1.6;
		margin: 0;
	}

	/* Sidebar (matches [...slug].astro) */

	@media (max-width: 820px) {
		.content-grid { grid-template-columns: 1fr; }
		.form-row { grid-template-columns: 1fr; }
	}

</style>
