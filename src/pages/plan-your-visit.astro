---
export const prerender = true;
/* Hallmark · macrostructure: Long Document · design-system: design.md · designed-as-app
 * Two-part page: the permission line up top, then logistics. Permission is set as a
 * policy statement, not reassurance marketing — trauma brains trust visible exits.
 * Copy unchanged; the permission lines now carry display weight instead of a tinted box.
 */
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
	title="Plan Your Visit | The Table Church"
	description="What you need to know before visiting The Table for the first time."
>
	<article class="visit">
		<header class="longform-mast band band-slate">
			<h1>Plan Your Visit</h1>
		</header>

		<div class="longform band band-cream">
			<div class="longform-inner">
				<aside class="aside-statement">
					<p>You don&rsquo;t have to know what you believe before you come.</p>
					<p>You don&rsquo;t have to stay if it isn&rsquo;t for you.</p>
				</aside>

				<section>
					<h2>When</h2>
					<p>Sundays at 5:00 pm.</p>
				</section>

				<section>
					<h2>Where</h2>
					<p>The Table meets inside First United Methodist Church of Sachse.</p>
					<address>
						1520 Blackburn Rd<br />
						Sachse, TX 75048
					</address>
				</section>

				<section>
					<h2>What to expect</h2>
					<p>If you want a clearer picture before you come, our <a href={base + '/what-sundays-are-like/'}>What Sundays Are Like</a> page walks through what actually happens — parking, dress, kids, communion, and how to leave quietly if you need to.</p>
				</section>

				<section>
					<h2>Questions</h2>
					<p>If you have a question you&rsquo;d rather ask before showing up, our <a href={base + '/contact-us/'}>contact page</a> has the email. We try to answer within a few days.</p>
				</section>
			</div>
		</div>
	</article>
</Layout>

<style>
	.aside-statement {
		margin-top: 0;
	}

	.aside-statement p + p {
		margin-top: var(--space-sm);
	}
</style>
