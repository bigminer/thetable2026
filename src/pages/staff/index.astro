---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug } from '../../lib/entry-slug';

const [staffEntries, groups] = await Promise.all([
  getCollection('staff', ({ data }) => !data.draft),
  getCollection('staff-groups', ({ data }) => !data.draft),
]);

const staffByGroup = new Map(groups.map((group) => [group.slug, [] as typeof staffEntries]));
const ungrouped = [] as typeof staffEntries;

for (const member of staffEntries.sort((left, right) => (left.data.order ?? 0) - (right.data.order ?? 0))) {
  const groupSlugs = member.data.groups?.map((group) => entrySlug(group)) ?? [];
  if (groupSlugs.length === 0) {
    ungrouped.push(member);
    continue;
  }
  for (const slug of groupSlugs) {
    const bucket = staffByGroup.get(slug);
    if (bucket) bucket.push(member);
  }
}

const sortedGroups = [...groups].sort((left, right) => (left.data.order ?? 0) - (right.data.order ?? 0));
---

<BaseLayout
  title="Staff"
  description="Staff directory and leadership profiles."
  canonicalPath="/staff/"
>
  <main class="page stack">
    <section class="hero stack">
      <p class="eyebrow">Staff</p>
      <h1>Staff directory</h1>
      <p class="lede">
        Leaders and staff are organized by group, with each profile carrying contact details and a short role summary.
      </p>
    </section>

    <section class="panel stack">
      {sortedGroups.map((group) => {
        const members = staffByGroup.get(group.slug) ?? [];

        return (
          <section class="group-stack">
            <div class="group-stack__heading">
              <h2>{group.data.title}</h2>
              {group.data.description && <p>{group.data.description}</p>}
            </div>
            <div class="staff-grid">
              {members.map((member) => (
                <a class="staff-card" href={`/staff/${entrySlug(member)}/`}>
                  {member.data.photo && <img src={member.data.photo.src} alt={member.data.photo.alt} />}
                  <div class="stack">
                    <h3>{member.data.name}</h3>
                    <p>{member.data.role}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      {ungrouped.length > 0 && (
        <section class="group-stack">
          <div class="group-stack__heading">
            <h2>Unassigned</h2>
          </div>
          <div class="staff-grid">
            {ungrouped.map((member) => (
              <a class="staff-card" href={`/staff/${entrySlug(member)}/`}>
                {member.data.photo && <img src={member.data.photo.src} alt={member.data.photo.alt} />}
                <div class="stack">
                  <h3>{member.data.name}</h3>
                  <p>{member.data.role}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .group-stack + .group-stack {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .group-stack__heading {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .staff-grid {
    display: grid;
    gap: 1rem;
  }

  .staff-card {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    background: var(--surface-soft);
  }

  .staff-card img {
    width: 100%;
    display: block;
    border-radius: 8px;
  }

  @media (min-width: 48rem) {
    .staff-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
