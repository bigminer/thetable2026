---
export const prerender = true;
/* Hallmark · macrostructure: Long Document · design-system: design.md · designed-as-app
 *
 * Photographic hero rather than the shared ContentPage figure, because the
 * wordmark sits inside the open doorway of the photograph. The source is a
 * 1200x1600 portrait; the banner crops to the torso band so both tees read at
 * size, and scales past `cover` for the zoom.
 *
 * The photo replaces the slate masthead the other pages open with, so the lede
 * gets its own slate band underneath it. Without that the page ran cream from
 * the hero to the footer and lost the two-ground rhythm the rest of the site
 * keeps.
 *
 * "How it works" is a genuinely ordinal three-step sequence, so it takes the
 * ledger treatment — the same numeral-left / label-right rhythm as the series
 * index and the homepage values, instead of a default ordered list.
 */
import Layout from '../layouts/Layout.astro';
import { resolveAsset } from '../lib/content';

const heroImage = resolveAsset('attachments/pages/merch/table-tees-doorway.jpg');

const steps = [
	{ verb: 'Browse', rest: ' the store and pick your size and color.' },
	{ verb: 'Order', rest: ' directly — Printful handles printing and shipping.' },
	{ verb: 'Receive', rest: ' your shirt, usually within a week or two.' },
];
---

<Layout
	title="The Table Merch | The Table Church"
	description="Shop official The Table Church merchandise — t-shirts printed on demand and shipped directly to you."
>
	<article class="merch">
		<header class="merch-hero band band-deep">
			<img
				class="merch-hero-img"
				src={heroImage}
				alt="Two people in The Table t-shirts holding open the doors of the church"
				width="1200"
				height="1600"
				fetchpriority="high"
			/>
			<div class="merch-hero-scrim" aria-hidden="true"></div>
			<h1 class="merch-hero-title">Shop<br />the Table</h1>
		</header>

		<div class="merch-lede-band band band-slate">
			<p class="merch-lede">Wear the mission. Every order supports The Table community.</p>
		</div>

		<div class="longform band band-cream">
			<div class="longform-inner">
				<p>Rep your church and carry the mission wherever you go. Our t-shirts are printed on demand through <a href="https://printful.com">Printful</a> — no inventory, no waste, shipped straight to your door.</p>

				<p class="cta-row"><a class="chip" href="https://the-table-tx.printful.me/">Shop now</a></p>

				<section>
					<h2 id="how-it-works">How It Works</h2>
					<ol class="ledger merch-steps">
						{steps.map((step, i) => (
							<li>
								<p class="ledger-key">{String(i + 1).padStart(2, '0')}</p>
								<p class="ledger-value"><strong>{step.verb}</strong>{step.rest}</p>
							</li>
						))}
					</ol>
					<p class="merch-close">No need to pick up anything at church. Questions? <a href="/contact-us/">Contact us</a>.</p>
				</section>
			</div>
		</div>
	</article>
</Layout>

<style>
	.merch-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-inline: 0;
		aspect-ratio: 2 / 1;
		max-height: 66vh;
	}

	.merch-hero-img {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* No transform. `cover` on a 1200x1600 portrait in a wide band already
		   scales to the full width, so the crop is vertical only — the whole scene
		   spans the page and just the ceiling and pavement are trimmed. A scale()
		   here would crop the sides and cut the two of them out of frame. */
		object-position: 50% 38%;
	}

	.merch-hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		/* Legibility scrim, not decoration: an ellipse over the doorway only, so the
		   wordmark holds contrast while both tees keep their colour. */
		background: radial-gradient(
			ellipse 30% 60% at 57% 52%,
			var(--scrim-band) 0%,
			var(--scrim-band-soft) 55%,
			transparent 100%
		);
	}

	/* Sits in the open doorway between the two of them. */
	.merch-hero-title {
		position: absolute;
		z-index: 2;
		left: 57%;
		top: 52%;
		transform: translate(-50%, -50%);
		margin: 0;
		text-align: center;
		font-size: clamp(1.75rem, 4.2vw, 3.75rem);
		font-weight: 800;
		line-height: 1.02;
		color: var(--color-ink-on-band);
	}

	/* Carries the slate ground the photo displaced. */
	.merch-lede-band {
		padding-block: var(--space-2xl);
	}

	.merch-lede {
		margin: 0;
		max-width: 24ch;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-2xl);
		line-height: var(--leading-display);
		letter-spacing: var(--track-display);
		text-transform: uppercase;
		color: var(--color-ink-on-band);
	}

	/* The next section's h2 carries a top rule; without clearance the chip's
	   border and that rule collide. */
	.cta-row {
		margin: var(--space-xl) 0 var(--space-2xl);
	}

	.cta-row .chip {
		font-size: var(--text-md);
		padding-inline: var(--space-2xl);
	}

	.merch-steps {
		margin-top: var(--space-lg);
	}

	/* Narrow key column — these are two-digit numerals, not words.
	   `max-width: none` because `.longform li` caps rows at the prose measure,
	   which left them narrower than the heading rule above. */
	.merch-steps > li {
		grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr);
		gap: var(--space-xs) var(--space-xl);
		padding-block: var(--space-lg);
		max-width: none;
	}

	.merch-steps .ledger-key {
		margin: 0;
		max-width: none;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--text-xl);
		line-height: 1.04;
		letter-spacing: var(--track-display);
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}

	.merch-steps .ledger-value {
		margin: 0;
		max-width: var(--measure);
	}

	.merch-steps .ledger-value strong {
		color: var(--color-ink);
		font-weight: 600;
	}

	.merch-close {
		margin-top: var(--space-xl);
	}

	@media (max-width: 60rem) {
		.merch-hero {
			aspect-ratio: 16 / 10;
		}

		.merch-lede-band {
			padding-block: var(--space-xl);
		}
	}

	@media (max-width: 40rem) {
		.merch-hero {
			aspect-ratio: 4 / 3;
		}

		.merch-lede {
			max-width: none;
			font-size: var(--text-xl);
		}

		.merch-steps > li {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
