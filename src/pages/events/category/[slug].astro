---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  formatPlanningCenterEvent,
  loadPlanningCenterCategories,
  loadPlanningCenterEvents,
} from '../../../lib/planning-center/events';

export async function getStaticPaths() {
  const categories = await loadPlanningCenterCategories();

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as {
  category: Awaited<ReturnType<typeof loadPlanningCenterCategories>>[number];
};

const events = (await loadPlanningCenterEvents()).filter((event) => event.categorySlug === category.slug);
---

<BaseLayout
  title={`${category.title} Events`}
  description={category.description ?? `${category.title} events and updates.`}
  canonicalPath={`/events/category/${category.slug}/`}
>
  <main class="page stack">
    <section class="hero stack">
      <img class="hero__mark" src="/favicon.svg" alt="" width="48" height="48" />
      <p class="eyebrow">Events category</p>
      <h1>{category.title}</h1>
      <p class="lede">{category.description ?? 'Planning Center-backed category archive.'}</p>
      <div class="actions">
        <a class="button button--secondary" href="/events/">
          Back to events
        </a>
      </div>
    </section>

    <section class="panel stack">
      <p class="eyebrow">Category events</p>
      <div class="stack">
        {events.length > 0 ? (
          events.map((event) => {
            const { dateLabel, timeLabel } = formatPlanningCenterEvent(event.startsAt);

            return (
              <article class="event-card">
                <p class="event-card__meta">
                  {dateLabel} · {timeLabel} · {event.location}
                </p>
                <h2 class="event-card__title">{event.title}</h2>
                <p class="event-card__summary">{event.summary}</p>
                <div class="event-card__actions">
                  <a class="button button--secondary" href={event.url}>
                    Open event
                  </a>
                </div>
              </article>
            );
          })
        ) : (
          <p class="lede">No upcoming events are currently listed in this category.</p>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .event-card {
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .event-card:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .event-card__meta {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .event-card__title {
    margin-top: 0.25rem;
    font-size: 1.125rem;
  }

  .event-card__summary {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .event-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
