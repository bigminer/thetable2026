---
import Layout from '../layouts/Layout.astro';
import { loadSource, isApproved, VIDEO_ID } from '../lib/sermon-chatbot/pilot.ts';
export const prerender = true;
const source = await loadSource();
const ready = source && isApproved(source);
---
<Layout title="Ask The Table" description="Find passages in a reviewed sermon from The Table." canonicalPath="/ask/" noindex={true}>
  <main>
    <header class="longform-mast band band-slate">
      <div class="longform-inner"><h1>Ask The Table</h1>
        <p>A small pilot for finding what Brett said, in his own words.</p>
      </div>
    </header>
    <div class="longform band band-cream"><div class="longform-inner">
      <p>{ready ? 'This pilot searches one reviewed sermon: Trauma Self Blame. It does not yet search the full archive.' : 'We’re preparing one sermon for review: Trauma Self Blame. Search will become available after that review.'}</p>
      <form id="ask-form" class="site-form">
        <label for="question">Your question</label>
        <input id="question" name="query" type="text" required maxlength="2000" placeholder="Why do I blame myself for everything?" disabled={!ready} aria-describedby="ask-privacy" />
        <p id="ask-privacy">When search is available, your question and matching sermon passages are sent to OpenAI to find relevant excerpts. Avoid including private details. This is a sermon search, not personal counseling.</p>
        <button type="submit" disabled={!ready}>Ask</button>
      </form>
      <div id="answer" role="status" aria-live="polite"></div>
      {ready && source && <section class="sources"><h2>Reviewed source</h2>
        <p><a href={`https://www.youtube.com/watch?v=${VIDEO_ID}&t=${Math.floor(source.start)}s`} target="_blank" rel="noreferrer">{source.title}</a> · {source.date}</p>
        <p>Excerpts preserve the reviewed transcript wording. Follow each timestamp to hear the original recording.</p>
      </section>}
    </div></div>
  </main>
  <script>
    import type { Answer } from '../lib/sermon-chatbot/pilot.ts';
    const form = document.querySelector<HTMLFormElement>('#ask-form')!;
    const input = document.querySelector<HTMLInputElement>('#question')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const output = document.querySelector<HTMLDivElement>('#answer')!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const query = input.value.trim();
      if (!query) return;
      button.disabled = true; button.textContent = 'Searching…';
      output.textContent = 'Finding relevant passages…';
      try {
        const response = await fetch('/api/ask/', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({query}), signal: AbortSignal.timeout(35000) });
        const data = await response.json() as Answer & { error?: string };
        if (!response.ok) throw new Error(data.error ?? 'Search is unavailable.');
        output.replaceChildren();
        const message = document.createElement('p'); message.textContent = data.message; output.append(message);
        for (const quote of data.quotes) {
          const block = document.createElement('blockquote'); block.textContent = quote.text; output.append(block);
          const citation = document.createElement('p');
          const link = document.createElement('a');
          const url = new URL(quote.url);
          if (url.origin !== 'https://www.youtube.com' || url.pathname !== '/watch'
              || url.searchParams.get('v') !== 'u7Q-WVrNLfc' || !/^\d+s$/.test(url.searchParams.get('t') ?? '')) throw new Error('Invalid source link.');
          link.href = url.href; link.target = '_blank'; link.rel = 'noreferrer';
          link.textContent = `${quote.title} · ${quote.date} · ${Math.floor(quote.seconds/60)}:${String(quote.seconds%60).padStart(2,'0')}`;
          citation.append(link); output.append(citation);
        }
      } catch (error) { output.textContent = error instanceof Error ? error.message : 'Search is unavailable.'; }
      finally { button.disabled = false; button.textContent = 'Ask'; }
    });
  </script>
  <style>
    .longform-inner { max-width: 760px; margin-inline: auto; }
    #answer { min-height: 2rem; margin-top: 2rem; }
    #ask-privacy { font-size: .875rem; color: var(--color-muted); }
    .sources { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--color-rule); }
    #answer :global(blockquote) { border-left: 2px solid var(--color-rule); margin: 1.5rem 0 .5rem; padding-left: 1rem; }
  </style>
</Layout>
