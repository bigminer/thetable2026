---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Staff template"
  description="A representative staff detail page."
  canonicalPath="/debug/templates/staff/"
  noindex={true}
>
  <main class="page stack">
    <section class="panel grid grid--2">
      <img class="hero__mark" src="/favicon.svg" alt="" width="48" height="48" />
      <div class="stack">
        <p class="eyebrow">Staff</p>
        <h1>Jane Doe</h1>
        <p class="lede">Lead Pastor</p>
        <p>
          A short profile keeps the page compact while leaving room for the contact links
          and order metadata the directory needs.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/debug/templates/podcast/">Podcast template</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
