---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Standard page template"
  description="A representative content page for the shared layout primitives."
  canonicalPath="/debug/templates/detail/"
  noindex={true}
>
  <main class="page stack">
    <section class="hero stack">
      <p class="eyebrow">Standard page</p>
      <h1>Standard page template</h1>
      <p class="lede">
        A representative content page with a two-column rhythm on larger screens and a
        single-column flow on mobile.
      </p>
      <div class="actions">
        <a class="button button--primary" href="/debug/planning-center/">Planning Center samples</a>
        <a class="button button--secondary" href="/sitemap.xml">Sitemap</a>
      </div>
    </section>

    <section class="grid grid--2">
      <article class="panel stack">
        <p class="eyebrow">Main content</p>
        <h2>Readable content block</h2>
        <p>
          This template keeps the content width steady, the spacing consistent, and the
          call to action clearly separated from the body copy.
        </p>
      </article>

      <aside class="panel stack">
        <p class="eyebrow">Supporting note</p>
        <h2>Supporting detail</h2>
        <p>
          The sidebar collapses into the same vertical rhythm on smaller screens without
          changing the copy order or the button treatment.
        </p>
      </aside>
    </section>
  </main>
</BaseLayout>
