---
const events = [
  {
    title: 'Sunday Gathering',
    date: 'Sunday, April 20',
    time: '5:00 PM',
    category: 'Service',
    location: 'FUMC Sachse',
    link: 'https://planningcenter.com/events/sunday-gathering',
  },
  {
    title: 'Community Meal',
    date: 'Wednesday, April 23',
    time: '6:30 PM',
    category: 'Fellowship',
    location: 'Hat Creek Burgers',
    link: 'https://planningcenter.com/events/community-meal',
  },
  {
    title: 'Youth Night',
    date: 'Friday, April 25',
    time: '7:00 PM',
    category: 'Youth',
    location: 'The Table Church',
    link: 'https://planningcenter.com/events/youth-night',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Planning Center events sample</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body {
        margin: 0;
        padding: 32px;
        background: #f5f7fb;
        color: #1f1f1f;
      }
      main {
        max-width: 900px;
      }
      h1 {
        margin: 0 0 20px;
        font-size: 2rem;
      }
      .event {
        border-top: 1px solid #d7d2c8;
        padding: 16px 0;
      }
      .meta {
        margin: 0 0 6px;
        color: #5f5a52;
      }
      .title {
        margin: 0 0 4px;
        font-size: 1.125rem;
      }
      a {
        color: #1f4b99;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Planning Center events sample</h1>
      {events.map((event) => (
        <article class="event">
          <p class="meta">{event.date} · {event.time} · {event.category} · {event.location}</p>
          <h2 class="title">{event.title}</h2>
          <a href={event.link}>Open event</a>
        </article>
      ))}
    </main>
  </body>
</html>
