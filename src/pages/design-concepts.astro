---
// Preview page for three homepage design concepts (Prismatic / Garden / Spectrum).
// Faithfully mirrors the Claude Design handoff prototype so the team can pick a direction.
// Standalone: bypasses BaseLayout because the prototype owns its own nav/footer/switcher.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>The Table Church — Design Concepts</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;0,800;0,900;1,300;1,400&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Serif+Display:ital@0;1&family=Bebas+Neue&display=swap">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Montserrat', sans-serif; background: #111; }

/* ── Concept switcher ── */
.switcher {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  gap: 0; background: #0a0a0a; border-bottom: 1px solid #222;
  padding: 0 24px;
}
.switcher-label { color: #555; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; margin-right: 20px; font-family: 'Montserrat', sans-serif; }
.sw-btn {
  padding: 14px 28px; font-family: 'Montserrat', sans-serif; font-size: 11px;
  font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  border: none; background: none; color: #555; cursor: pointer;
  border-bottom: 2px solid transparent; transition: all .2s;
  position: relative; top: 1px;
}
.sw-btn:hover { color: #fff; }
.sw-btn.active { color: #fff; border-bottom-color: #fff; }
.sw-btn .dot {
  display: inline-block; width: 7px; height: 7px; border-radius: 50%;
  margin-right: 7px; vertical-align: middle; position: relative; top: -1px;
}

/* ── Concepts ── */
.concept { display: none; }
.concept.visible { display: block; }

/* ════════════════════════════════════════════════
   CONCEPT A — PRISMATIC
   Dark cathedral. Rainbow as stained-glass light.
   ════════════════════════════════════════════════ */
.cA {
  --bg: #0e0d0b;
  --bg2: #141210;
  --surface: #1a1815;
  --ink: #f0ece4;
  --muted: #8a8278;
  --accent: #f0ece4;
  --spectrum: linear-gradient(90deg, #e63946, #f4a261, #e9c46a, #52b788, #4361ee, #7b2d8b);
  font-family: 'Montserrat', sans-serif;
  background: var(--bg);
  color: var(--ink);
  padding-top: 49px;
}

/* nav */
.cA .nav {
  position: sticky; top: 49px; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px 56px;
  background: rgba(14,13,11,0.92); backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.cA .nav-logo { font-size: 13px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); }
.cA .nav-logo span { display: block; width: 32px; height: 2px; margin-top: 4px; background: var(--spectrum); border-radius: 2px; }
.cA .nav-links { display: flex; gap: 36px; list-style: none; }
.cA .nav-links a { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; transition: color .2s; }
.cA .nav-links a:hover { color: var(--ink); }
.cA .nav-cta { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--bg); background: var(--ink); padding: 10px 22px; text-decoration: none; transition: all .2s; }
.cA .nav-cta:hover { background: #e9c46a; }

/* hero */
.cA .hero {
  position: relative; min-height: 92vh;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 80px 56px 72px;
  overflow: hidden;
}
.cA .hero-img {
  position: absolute; inset: 0;
  background: url('/design-concepts/join-us.png') center/cover no-repeat;
  filter: brightness(.28) saturate(.6);
}
.cA .hero-spectrum {
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--spectrum);
}
.cA .hero-spectrum-glow {
  position: absolute; top: 0; left: 0; right: 0; height: 180px;
  background: linear-gradient(180deg, rgba(113,60,180,.18) 0%, transparent 100%);
  pointer-events: none;
}
.cA .hero-content { position: relative; z-index: 2; max-width: 820px; }
.cA .hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 24px; }
.cA .hero-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(64px, 8vw, 120px); font-weight: 900; line-height: 1;
  color: var(--ink); margin-bottom: 32px; letter-spacing: -.02em;
}
.cA .hero-title em { font-style: italic; }
.cA .hero-sub { font-size: 16px; font-weight: 400; color: var(--muted); max-width: 480px; line-height: 1.7; margin-bottom: 48px; }
.cA .hero-actions { display: flex; gap: 16px; align-items: center; }
.cA .btn-primary { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; background: var(--ink); color: var(--bg); padding: 16px 32px; text-decoration: none; transition: all .2s; }
.cA .btn-primary:hover { background: #e9c46a; }
.cA .btn-ghost { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color .2s; }
.cA .btn-ghost:hover { color: var(--ink); }

/* who we are */
.cA .who {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  min-height: 60vh;
}
.cA .who-copy { padding: 96px 56px; display: flex; flex-direction: column; justify-content: center; }
.cA .who-photo {
  background: url('/design-concepts/values-pic.jpg') center/cover no-repeat;
  filter: saturate(.7);
}
.cA .section-label { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 20px; }
.cA .section-label::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--muted); margin-right: 10px; vertical-align: middle; }
.cA .section-heading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(36px, 4vw, 56px); font-weight: 700; line-height: 1.1;
  color: var(--ink); margin-bottom: 32px;
}
.cA .section-heading b { font-weight: 900; }
.cA .section-body { font-size: 15px; line-height: 1.8; color: var(--muted); max-width: 460px; }
.cA .values-list { margin-top: 40px; display: flex; flex-direction: column; gap: 0; }
.cA .value-item { padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.06); display: flex; align-items: baseline; gap: 16px; }
.cA .value-item:last-child { border-bottom: 1px solid rgba(255,255,255,0.06); }
.cA .value-name { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink); min-width: 120px; }
.cA .value-desc { font-size: 13px; color: var(--muted); line-height: 1.6; }

/* you belong */
.cA .belong { background: var(--surface); padding: 120px 56px; text-align: center; position: relative; overflow: hidden; }
.cA .belong-spectrum { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--spectrum); }
.cA .belong-quote {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(32px, 5vw, 72px); font-weight: 400; font-style: italic;
  line-height: 1.2; color: var(--ink); max-width: 900px; margin: 0 auto 24px;
}
.cA .belong-quote b { font-weight: 900; font-style: italic; }
.cA .belong-sub { font-size: 14px; color: var(--muted); max-width: 520px; margin: 0 auto; line-height: 1.8; }

/* affirming */
.cA .affirming {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  min-height: 56vh;
}
.cA .affirming-photo {
  background: url('/design-concepts/affirming-hero.png') center/cover no-repeat;
  filter: saturate(.65) brightness(.85);
  position: relative;
}
.cA .affirming-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(14,13,11,1)); }
.cA .affirming-copy { padding: 80px 56px 80px 64px; display: flex; flex-direction: column; justify-content: center; }
.cA .affirming-list { margin-top: 32px; display: flex; flex-direction: column; gap: 14px; }
.cA .affirming-item { font-size: 14px; color: var(--muted); line-height: 1.5; padding-left: 20px; position: relative; }
.cA .affirming-item::before { content: ''; position: absolute; left: 0; top: 9px; width: 8px; height: 1px; background: var(--spectrum); }

/* CTA */
.cA .cta-band {
  padding: 100px 56px; text-align: center;
  background: var(--bg2);
}
.cA .cta-time { font-size: clamp(48px, 6vw, 88px); font-family: 'Playfair Display', serif; font-weight: 900; color: var(--ink); margin-bottom: 12px; }
.cA .cta-date { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 40px; }

/* footer */
.cA .footer { padding: 56px; border-top: 1px solid rgba(255,255,255,.06); display: flex; justify-content: space-between; align-items: center; }
.cA .footer-logo { font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
.cA .footer-addr { font-size: 12px; color: var(--muted); line-height: 1.7; text-align: right; }


/* ════════════════════════════════════════════════
   CONCEPT B — GARDEN
   Warm, organic, earthy. Cream + sage + terracotta.
   Rainbow as gentle arc / botanical accent.
   ════════════════════════════════════════════════ */
.cB {
  --bg: #faf6ef;
  --bg2: #f2ebe0;
  --surface: #ffffff;
  --ink: #1e1a14;
  --muted: #7a6f60;
  --terra: #c45c3a;
  --sage: #5a7a5e;
  --gold: #c9912a;
  --spectrum: linear-gradient(90deg, #e63946, #f4a261, #e9c46a, #52b788, #4361ee, #7b2d8b);
  font-family: 'Montserrat', sans-serif;
  background: var(--bg);
  color: var(--ink);
  padding-top: 49px;
}

/* nav */
.cB .nav {
  position: sticky; top: 49px; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 56px;
  background: var(--bg); border-bottom: 1px solid rgba(0,0,0,.07);
}
.cB .nav-logo { font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); }
.cB .nav-logo .tagline { display: block; font-size: 9px; font-weight: 500; letter-spacing: .08em; color: var(--muted); text-transform: none; margin-top: 2px; }
.cB .nav-links { display: flex; gap: 32px; list-style: none; }
.cB .nav-links a { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; transition: color .2s; }
.cB .nav-links a:hover { color: var(--terra); }
.cB .nav-cta { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--surface); background: var(--terra); padding: 10px 22px; border-radius: 2px; text-decoration: none; transition: all .2s; }
.cB .nav-cta:hover { background: var(--ink); }

/* hero */
.cB .hero {
  position: relative; overflow: hidden;
  min-height: 88vh; display: grid; grid-template-columns: 1fr 1fr;
}
.cB .hero-left {
  padding: 96px 56px 96px 56px; display: flex; flex-direction: column;
  justify-content: center; background: var(--bg); position: relative; z-index: 2;
}
.cB .hero-arc {
  position: absolute; top: -40px; right: -120px; width: 280px; height: 280px;
  border-radius: 50%; border: 3px solid transparent;
  background: var(--spectrum) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: destination-out; mask-composite: exclude;
  opacity: .7;
}
.cB .hero-eyebrow { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--terra); margin-bottom: 24px; }
.cB .hero-title {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: clamp(52px, 6vw, 96px); font-weight: 400; line-height: .95;
  color: var(--ink); margin-bottom: 36px;
}
.cB .hero-title em { font-style: italic; color: var(--terra); }
.cB .hero-sub { font-size: 15px; color: var(--muted); line-height: 1.8; max-width: 400px; margin-bottom: 48px; }
.cB .hero-time-badge {
  display: inline-flex; align-items: center; gap: 12px;
  border: 1.5px solid rgba(0,0,0,.12); padding: 14px 24px; border-radius: 2px;
  font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink);
  margin-bottom: 24px;
}
.cB .hero-time-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sage); }
.cB .hero-right {
  position: relative; overflow: hidden;
}
.cB .hero-img {
  position: absolute; inset: 0;
  background: url('/design-concepts/join-us.png') center/cover no-repeat;
}
.cB .hero-img-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, var(--bg) 0%, transparent 25%);
}
.cB .hero-spectrum-strip {
  position: absolute; bottom: 0; left: 0; right: 0; height: 4px;
  background: var(--spectrum);
}

/* who */
.cB .who { padding: 112px 56px; background: var(--bg2); }
.cB .who-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; }
.cB .section-label { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--terra); margin-bottom: 20px; }
.cB .section-heading {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: clamp(36px, 4vw, 56px); font-weight: 400; line-height: 1.05;
  color: var(--ink); margin-bottom: 28px;
}
.cB .section-body { font-size: 15px; color: var(--muted); line-height: 1.8; }
.cB .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin-top: 4px; }
.cB .value-card {
  background: var(--surface); padding: 32px 28px;
  transition: background .2s;
}
.cB .value-card:hover { background: #fff9f2; }
.cB .value-card:nth-child(5) { grid-column: 1 / -1; }
.cB .value-num { font-size: 10px; font-weight: 800; letter-spacing: .12em; color: var(--terra); margin-bottom: 12px; opacity: .7; }
.cB .value-name { font-family: 'DM Serif Display', serif; font-size: 24px; color: var(--ink); margin-bottom: 10px; }
.cB .value-desc { font-size: 13px; color: var(--muted); line-height: 1.7; }

/* belong */
.cB .belong {
  padding: 0; display: grid; grid-template-columns: 1fr 1fr; min-height: 56vh;
}
.cB .belong-photo {
  background: url('/design-concepts/family.png') center/cover no-repeat;
  filter: saturate(.85);
}
.cB .belong-copy {
  background: var(--ink); color: #f0ece4;
  padding: 96px 64px; display: flex; flex-direction: column; justify-content: center;
}
.cB .belong-copy .section-label { color: var(--gold); }
.cB .belong-quote {
  font-family: 'DM Serif Display', serif; font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 400; line-height: 1.2; margin-bottom: 24px; color: #f0ece4;
}
.cB .belong-quote em { font-style: italic; color: var(--gold); }
.cB .belong-body { font-size: 14px; color: rgba(240,236,228,.65); line-height: 1.8; max-width: 400px; }
.cB .belong-spectrum { display: block; width: 100%; height: 3px; background: var(--spectrum); margin-top: 40px; border-radius: 2px; }

/* affirming */
.cB .affirming { padding: 112px 56px; background: var(--bg); }
.cB .affirming-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; }
.cB .affirming-list { margin-top: 36px; display: flex; flex-direction: column; gap: 16px; }
.cB .affirming-item {
  font-size: 14px; color: var(--muted); line-height: 1.6;
  padding: 16px 20px; background: var(--bg2); border-left: 3px solid transparent;
  border-image: var(--spectrum) 1;
}
.cB .affirming-photo {
  border-radius: 2px; overflow: hidden;
  background: url('/design-concepts/affirming-hero.png') center/cover no-repeat;
  aspect-ratio: 4/5;
}

/* CTA */
.cB .cta-band {
  background: var(--terra); color: #fff;
  padding: 80px 56px; text-align: center;
}
.cB .cta-hed { font-family: 'DM Serif Display', serif; font-size: clamp(40px, 5vw, 72px); font-weight: 400; margin-bottom: 16px; }
.cB .cta-hed em { font-style: italic; }
.cB .cta-sub { font-size: 14px; opacity: .8; margin-bottom: 40px; line-height: 1.7; }
.cB .cta-btn { display: inline-block; background: #fff; color: var(--terra); font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; padding: 16px 36px; text-decoration: none; transition: all .2s; }
.cB .cta-btn:hover { background: var(--ink); color: #fff; }

/* footer */
.cB .footer { padding: 48px 56px; background: var(--ink); display: flex; justify-content: space-between; align-items: center; }
.cB .footer-logo { font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.4); }
.cB .footer-addr { font-size: 12px; color: rgba(255,255,255,.35); line-height: 1.7; text-align: right; }


/* ════════════════════════════════════════════════
   CONCEPT C — SPECTRUM EDITORIAL
   Clean white + heavy black type + rainbow as bold architectural element.
   Modern magazine / progressive brand energy.
   ════════════════════════════════════════════════ */
.cC {
  --bg: #fafaf9;
  --surface: #ffffff;
  --ink: #111010;
  --muted: #6b6762;
  --spectrum: linear-gradient(90deg, #e63946 0%, #f4a261 20%, #e9c46a 40%, #52b788 60%, #4361ee 80%, #7b2d8b 100%);
  font-family: 'Montserrat', sans-serif;
  background: var(--bg);
  color: var(--ink);
  padding-top: 49px;
}

/* nav */
.cC .nav {
  position: sticky; top: 49px; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 56px; height: 64px;
  background: var(--surface); border-bottom: 1px solid #e8e8e8;
}
.cC .nav-spectrum { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--spectrum); }
.cC .nav-logo { font-size: 15px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); }
.cC .nav-links { display: flex; gap: 36px; list-style: none; }
.cC .nav-links a { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; transition: color .2s; }
.cC .nav-links a:hover { color: var(--ink); }
.cC .nav-cta { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--surface); background: var(--ink); padding: 10px 22px; text-decoration: none; transition: all .2s; }
.cC .nav-cta:hover { background: #4361ee; }

/* hero */
.cC .hero { padding: 0; }
.cC .hero-spectrum-bar { height: 10px; background: var(--spectrum); }
.cC .hero-inner {
  display: grid; grid-template-columns: 1fr 1fr; min-height: 84vh;
}
.cC .hero-left {
  padding: 80px 56px; display: flex; flex-direction: column; justify-content: space-between;
  border-right: 1px solid #e8e8e8;
}
.cC .hero-eyebrow {
  font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase;
  color: var(--muted); display: flex; align-items: center; gap: 12px;
}
.cC .hero-eyebrow::after { content: ''; flex: 1; height: 1px; background: #e8e8e8; }
.cC .hero-title {
  font-size: clamp(72px, 9vw, 140px); font-weight: 900; line-height: .88;
  letter-spacing: -.04em; color: var(--ink); text-transform: uppercase;
}
.cC .hero-title .rainbow-word {
  background: var(--spectrum); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.cC .hero-bottom { }
.cC .hero-sub { font-size: 15px; color: var(--muted); line-height: 1.7; max-width: 380px; margin-bottom: 32px; }
.cC .hero-actions { display: flex; gap: 16px; }
.cC .btn-primary { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; background: var(--ink); color: #fff; padding: 15px 32px; text-decoration: none; transition: all .2s; }
.cC .btn-primary:hover { background: #4361ee; }
.cC .btn-ghost { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); text-decoration: none; border: 1px solid #e8e8e8; padding: 14px 28px; transition: all .2s; }
.cC .btn-ghost:hover { border-color: var(--ink); color: var(--ink); }
.cC .hero-right {
  position: relative; overflow: hidden;
}
.cC .hero-img-wrap {
  position: absolute; inset: 0;
  background: url('/design-concepts/join-us.png') center/cover no-repeat;
}
.cC .hero-caption {
  position: absolute; bottom: 32px; left: 32px; right: 32px;
  background: rgba(255,255,255,.92); backdrop-filter: blur(8px);
  padding: 20px 24px; border-left: 4px solid transparent;
  border-image: var(--spectrum) 1;
}
.cC .hero-caption p { font-size: 13px; font-weight: 600; color: var(--ink); line-height: 1.5; }

/* who */
.cC .who { padding: 120px 56px; }
.cC .who-header { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid #e8e8e8; padding-bottom: 24px; margin-bottom: 64px; }
.cC .section-label { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
.cC .who-big-text {
