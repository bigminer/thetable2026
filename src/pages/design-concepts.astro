/* ════════════════════════════════════════════════
   CONCEPT D — CATHEDRAL (A + C fusion)
   Dark cathedral palette + Playfair italic tenderness,
   with architectural rainbow boldness: 10px spectrum bar,
   rainbow-word gradient text, 5-up values row with
   rainbow underbars, editorial belong split.
   ════════════════════════════════════════════════ */
.cD {
  --bg: #0e0d0b;
  --bg2: #141210;
  --surface: #1a1815;
  --surface2: #211e1a;
  --ink: #f0ece4;
  --muted: #8a8278;
  --line: rgba(255,255,255,.08);
  --spectrum: linear-gradient(90deg, #e63946, #f4a261, #e9c46a, #52b788, #4361ee, #7b2d8b);
  font-family: 'Montserrat', sans-serif;
  background: var(--bg);
  color: var(--ink);
  padding-top: 49px;
}

/* nav */
.cD .nav {
  position: sticky; top: 49px; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px 56px;
  background: rgba(14,13,11,0.92); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.cD .nav-spectrum { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--spectrum); }
.cD .nav-logo { font-size: 13px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); }
.cD .nav-links { display: flex; gap: 36px; list-style: none; }
.cD .nav-links a { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; transition: color .2s; }
.cD .nav-links a:hover { color: var(--ink); }
.cD .nav-cta { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--bg); background: var(--ink); padding: 10px 22px; text-decoration: none; transition: all .2s; }
.cD .nav-cta:hover { background: #e9c46a; }

/* hero — A mood with C architecture */
.cD .hero {
  position: relative; min-height: 92vh;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 80px 56px 72px;
  overflow: hidden;
}
.cD .hero-img {
  position: absolute; inset: 0;
  background: url('/design-concepts/join-us.png') center/cover no-repeat;
  filter: brightness(.28) saturate(.6);
}
.cD .hero-spectrum-bar { position: absolute; top: 0; left: 0; right: 0; height: 10px; background: var(--spectrum); }
.cD .hero-spectrum-glow {
  position: absolute; top: 0; left: 0; right: 0; height: 220px;
  background: linear-gradient(180deg, rgba(123,45,139,.22) 0%, transparent 100%);
  pointer-events: none;
}
.cD .hero-content { position: relative; z-index: 2; max-width: 900px; }
.cD .hero-eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 28px;
  display: flex; align-items: center; gap: 14px;
}
.cD .hero-eyebrow::before { content: ''; width: 32px; height: 1px; background: var(--spectrum); }
.cD .hero-title {
  font-size: clamp(64px, 8.5vw, 132px); font-weight: 900; line-height: .88;
  color: var(--ink); margin-bottom: 32px; letter-spacing: -.04em;
  text-transform: uppercase;
}
.cD .hero-title em { font-style: normal; }
.cD .hero-title .rainbow-word {
  background: var(--spectrum); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; color: transparent;
}
.cD .hero-sub { font-size: 16px; color: var(--muted); max-width: 480px; line-height: 1.75; margin-bottom: 48px; }
.cD .hero-actions { display: flex; gap: 20px; align-items: center; }
.cD .btn-primary { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; background: var(--ink); color: var(--bg); padding: 16px 32px; text-decoration: none; transition: all .2s; }
.cD .btn-primary:hover { background: #e9c46a; }
.cD .btn-ghost { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); text-decoration: none; border: 1px solid var(--line); padding: 15px 26px; transition: all .2s; }
.cD .btn-ghost:hover { color: var(--ink); border-color: var(--ink); }

/* who — C editorial framing in dark */
.cD .who { padding: 120px 56px; background: var(--bg); }
.cD .who-header { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 64px; gap: 32px; flex-wrap: wrap; }
.cD .section-label { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
.cD .who-big-text {
  font-size: clamp(40px, 5vw, 80px); font-weight: 900; letter-spacing: -.03em;
  line-height: 1; color: var(--ink); text-transform: uppercase;
}
.cD .who-big-text em { font-style: normal; }
.cD .who-big-text .rainbow-word {
  background: var(--spectrum); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; color: transparent;
}
.cD .who-body-row { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; margin-bottom: 72px; }
.cD .who-body-copy { font-size: 15px; color: var(--muted); line-height: 1.85; }
.cD .values-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); }
.cD .val-block { background: var(--bg2); padding: 36px 28px; transition: background .2s; }
.cD .val-block:hover { background: var(--surface2); }
.cD .val-num { font-size: 10px; font-weight: 800; letter-spacing: .12em; color: var(--muted); margin-bottom: 24px; }
.cD .val-name {
  font-size: 18px; font-weight: 900; letter-spacing: -.01em;
  text-transform: uppercase; color: var(--ink); margin-bottom: 14px;
}
.cD .val-bar { width: 40px; height: 2px; background: var(--spectrum); margin-bottom: 16px; }
.cD .val-desc { font-size: 12.5px; color: var(--muted); line-height: 1.7; }

/* belong — C split architecture, A italic tenderness */
.cD .belong {
  background: var(--surface); padding: 0;
  display: grid; grid-template-columns: 1fr 1.6fr; min-height: 64vh;
}
.cD .belong-spectrum-col { background: var(--spectrum); width: 100%; min-height: 320px; }
.cD .belong-copy { padding: 100px 72px; display: flex; flex-direction: column; justify-content: center; }
.cD .belong-label { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 28px; }
.cD .belong-quote {
  font-size: clamp(36px, 4.5vw, 68px); font-weight: 900;
  line-height: .95; letter-spacing: -.03em; text-transform: uppercase;
  color: var(--ink); margin-bottom: 28px; max-width: 720px;
}
.cD .belong-quote b { font-weight: 900; }
.cD .belong-body { font-size: 14.5px; color: var(--muted); line-height: 1.85; max-width: 480px; }

/* affirming — A photo/copy split with C chip grid */
.cD .affirming {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  min-height: 64vh;
}
.cD .affirming-photo {
  background: url('/design-concepts/affirming-hero.png') center/cover no-repeat;
  filter: saturate(.7) brightness(.8);
  position: relative;
}
.cD .affirming-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 55%, rgba(14,13,11,1)); }
.cD .affirming-copy { padding: 100px 64px; display: flex; flex-direction: column; justify-content: center; background: var(--bg); }
.cD .affirming-headline {
  font-size: clamp(34px, 4vw, 56px); font-weight: 900; line-height: 1.0;
  text-transform: uppercase; color: var(--ink); margin-bottom: 16px; letter-spacing: -.02em;
}
.cD .affirming-headline em { font-style: normal; }
.cD .affirming-sub { font-size: 14.5px; color: var(--muted); line-height: 1.8; max-width: 420px; margin-bottom: 32px; }
.cD .affirming-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
.cD .affirm-chip {
  background: var(--bg2); padding: 18px 20px; font-size: 12.5px; font-weight: 600;
  color: var(--ink); letter-spacing: .01em; line-height: 1.4;
  border-top: 2px solid transparent; border-image: var(--spectrum) 1;
}

/* CTA — A Playfair time, C bar */
.cD .cta-band { padding: 0; background: var(--bg2); }
.cD .cta-spectrum { height: 6px; background: var(--spectrum); }
.cD .cta-inner { padding: 110px 56px; text-align: center; }
.cD .cta-time {
  font-size: clamp(48px, 6.5vw, 96px); font-weight: 900;
  text-transform: uppercase; color: var(--ink); margin-bottom: 14px; letter-spacing: -.04em; line-height: .9;
}
.cD .cta-time em { font-style: normal; }
.cD .cta-date { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 44px; }

/* footer */
.cD .footer { padding: 48px 56px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; position: relative; }
.cD .footer-spectrum { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--spectrum); opacity: .5; }
.cD .footer-logo { font-size: 12px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
.cD .footer-addr { font-size: 12px; color: var(--muted); line-height: 1.7; text-align: right; }


/* ── Concept D light-mode overrides ── */
.cD.light-mode {
  --bg: #fafaf8;
  --bg2: #f2efe9;
  --surface: #ffffff;
  --surface2: #f0ece4;
  --ink: #1a1712;
  --muted: #7a7068;
  --line: rgba(0,0,0,.09);
}
.cD.light-mode .hero-img { filter: brightness(.45) saturate(.7); }
.cD.light-mode .nav { background: rgba(250,250,248,0.94); }
.cD.light-mode .affirming-photo { filter: saturate(.85) brightness(.95); }
.cD.light-mode .affirming-photo::after { background: linear-gradient(90deg, transparent 55%, var(--bg)); }
.cD.light-mode #theme-toggle { border-color: rgba(0,0,0,.18); }
.cD.light-mode .val-block { background: var(--bg2); }
.cD.light-mode .val-block:hover { background: var(--surface2); }
.cD.light-mode .affirm-chip { background: var(--bg2); }
.cD.light-mode .cta-inner { background: var(--bg); }
.cD.light-mode .footer { border-top-color: var(--line); }

/* ── Tweaks Panel ── */
#tweaks-panel {
  display: none; position: fixed; bottom: 24px; right: 24px; z-index: 9999;
  background: #fff; border: 1px solid #e8e8e8; box-shadow: 0 8px 32px rgba(0,0,0,.12);
