<!-- Tweaks Panel -->
<div id="tweaks-panel">
  <h3>Tweaks</h3>
  <div class="tweak-group">
    <label>Concept</label>
    <div class="tweak-pills">
      <div class="tweak-pill active" data-tweak-concept="A">Prismatic</div>
      <div class="tweak-pill" data-tweak-concept="B">Garden</div>
      <div class="tweak-pill" data-tweak-concept="C">Spectrum</div>
      <div class="tweak-pill" data-tweak-concept="D">Cathedral</div>
    </div>
  </div>
  <div class="tweak-group" id="tweak-spectrum-weight-group">
    <label>Rainbow Intensity</label>
    <div class="tweak-pills">
      <div class="tweak-pill" data-tweak-intensity="subtle">Subtle</div>
      <div class="tweak-pill active" data-tweak-intensity="normal">Normal</div>
      <div class="tweak-pill" data-tweak-intensity="bold">Bold</div>
    </div>
  </div>
</div>


<script is:inline>
const TWEAK_DEFAULTS = { concept: "A", intensity: "normal", theme: "dark" };
let state = { ...TWEAK_DEFAULTS };
try { const s = localStorage.getItem('table-concepts'); if (s) state = { ...state, ...JSON.parse(s) }; } catch(e) {}

function showConcept(id) {
  document.querySelectorAll('.concept').forEach(el => el.classList.remove('visible'));
  document.getElementById('concept-' + id).classList.add('visible');
  document.querySelectorAll('.sw-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.concept === id);
  });
  document.querySelectorAll('[data-tweak-concept]').forEach(p => {
    p.classList.toggle('active', p.dataset.tweakConcept === id);
  });
  state.concept = id;
  save();
}

function setSpectrumIntensity(level) {
  const map = {
    subtle: 'linear-gradient(90deg, rgba(230,57,70,.45), rgba(244,162,97,.45), rgba(233,196,106,.45), rgba(82,183,136,.45), rgba(67,97,238,.45), rgba(123,45,139,.45))',
    normal: 'linear-gradient(90deg, #e63946, #f4a261, #e9c46a, #52b788, #4361ee, #7b2d8b)',
    bold:   'linear-gradient(90deg, #e63946 0%, #f4a261 16%, #e9c46a 33%, #52b788 50%, #4361ee 75%, #7b2d8b 100%)'
  };
  const v = map[level] || map.normal;
  document.querySelectorAll('.cA, .cB, .cC, .cD').forEach(el => el.style.setProperty('--spectrum', v));
  document.querySelectorAll('[data-tweak-intensity]').forEach(p => {
    p.classList.toggle('active', p.dataset.tweakIntensity === level);
  });
  state.intensity = level;
  save();
}

function setTheme(theme) {
  const conceptD = document.getElementById('concept-D');
  const btn = document.getElementById('theme-toggle');
  if (theme === 'light') {
    conceptD.classList.add('light-mode');
    if (btn) btn.textContent = '☾ Dark';
  } else {
    conceptD.classList.remove('light-mode');
    if (btn) btn.textContent = '☀ Light';
  }
  state.theme = theme;
  save();
}

function toggleTheme() {
  setTheme(state.theme === 'light' ? 'dark' : 'light');
}

function save() {
  try { localStorage.setItem('table-concepts', JSON.stringify(state)); } catch(e) {}
}

document.querySelectorAll('.sw-btn').forEach(btn => {
  btn.addEventListener('click', () => showConcept(btn.dataset.concept));
});
document.querySelectorAll('[data-tweak-concept]').forEach(p => {
  p.addEventListener('click', () => showConcept(p.dataset.tweakConcept));
});
document.querySelectorAll('[data-tweak-intensity]').forEach(p => {
  p.addEventListener('click', () => setSpectrumIntensity(p.dataset.tweakIntensity));
});

const themeBtn = document.getElementById('theme-toggle');
if (themeBtn) themeBtn.addEventListener('click', toggleTheme);

// Tweaks panel toggle — press "T" to open/close
document.addEventListener('keydown', e => {
  if (e.key === 't' || e.key === 'T') {
    document.getElementById('tweaks-panel').classList.toggle('open');
  }
});

// Restore state
showConcept(state.concept || 'A');
if (state.intensity && state.intensity !== 'normal') setSpectrumIntensity(state.intensity);
if (state.theme === 'light') setTheme('light');
</script>
